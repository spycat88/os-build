From: Teguh Sobirin <teguh@sobir.in>
Date: Wed, 9 Sep 2026 06:10:21 +0700
Subject: [PATCH] Bluetooth: hci_qca: add WCN7750 with host-managed supplies

WCN7750 is a Wi-Fi 7 combo part whose Bluetooth side is the QCC2072
core: same TLV rampatch and NVM flow, same "orn" firmware files. Where
it differs is power. The QCC2072 device data leaves the rails to the
platform (num_vregs = 0); on the boards carrying WCN7750 the BT rails
are switched by the host and vddio in particular is not always on.

Backported to Armada Linux 7.2.6, retaining the existing WCN7860 support.

Signed-off-by: Teguh Sobirin <teguh@sobir.in>

Ported from armada (armada-os/armada b91b786) 1166, body unchanged (offsets only on top of `1029`).
---
 drivers/bluetooth/btqca.c   | 10 ++++++++++
 drivers/bluetooth/btqca.h   |  1 +
 drivers/bluetooth/hci_qca.c | 34 ++++++++++++++++++++++++++++++++++
 3 files changed, 45 insertions(+)

diff --git a/drivers/bluetooth/btqca.c b/drivers/bluetooth/btqca.c
index 0c3755777..459d0fd48 100644
--- a/drivers/bluetooth/btqca.c
+++ b/drivers/bluetooth/btqca.c
@@ -832,6 +832,10 @@ int qca_uart_setup(struct hci_dev *hdev, uint8_t baudrate,
 			snprintf(config.fwname, sizeof(config.fwname),
 				 "qca/gngbtfw%02x.mbn", rom_ver);
 			break;
+		case QCA_WCN7750:
+			snprintf(config.fwname, sizeof(config.fwname),
+				 "qca/ornbtfw%02x.tlv", rom_ver);
+			break;
 		default:
 			snprintf(config.fwname, sizeof(config.fwname),
 				 "qca/rampatch_%08x.bin", soc_ver);
@@ -930,6 +934,10 @@ int qca_uart_setup(struct hci_dev *hdev, uint8_t baudrate,
 			qca_get_nvm_name_by_board(config.fwname, sizeof(config.fwname),
 				 "gngbtnv", soc_type, ver, rom_ver, boardid);
 			break;
+		case QCA_WCN7750:
+			snprintf(config.fwname, sizeof(config.fwname),
+				 "qca/ornnv%02x.bin", rom_ver);
+			break;
 		default:
 			snprintf(config.fwname, sizeof(config.fwname),
 				 "qca/nvm_%08x.bin", soc_ver);
@@ -957,6 +965,7 @@ int qca_uart_setup(struct hci_dev *hdev, uint8_t baudrate,
 	case QCA_WCN6855:
 	case QCA_WCN7850:
 	case QCA_WCN7860:
+	case QCA_WCN7750:
 		err = qca_disable_soc_logging(hdev);
 		if (err < 0)
 			return err;
@@ -995,6 +1004,7 @@ int qca_uart_setup(struct hci_dev *hdev, uint8_t baudrate,
 	case QCA_WCN6855:
 	case QCA_WCN7850:
 	case QCA_WCN7860:
+	case QCA_WCN7750:
 		/* get fw build info */
 		err = qca_read_fw_build_info(hdev);
 		if (err < 0)
diff --git a/drivers/bluetooth/btqca.h b/drivers/bluetooth/btqca.h
index 3fe18739e..00721ec28 100644
--- a/drivers/bluetooth/btqca.h
+++ b/drivers/bluetooth/btqca.h
@@ -159,6 +159,7 @@ enum qca_btsoc_type {
 	QCA_WCN6855,
 	QCA_WCN7850,
 	QCA_WCN7860,
+	QCA_WCN7750,
 };
 
 #if IS_ENABLED(CONFIG_BT_QCA)
diff --git a/drivers/bluetooth/hci_qca.c b/drivers/bluetooth/hci_qca.c
index 95cc66d75..affde0de4 100644
--- a/drivers/bluetooth/hci_qca.c
+++ b/drivers/bluetooth/hci_qca.c
@@ -1383,6 +1383,7 @@ static int qca_set_baudrate(struct hci_dev *hdev, uint8_t baudrate)
 	case QCA_WCN6750:
 	case QCA_WCN6855:
 	case QCA_WCN7850:
+	case QCA_WCN7750:
 	case QCA_WCN7860:
 		usleep_range(1000, 10000);
 		break;
@@ -1503,6 +1504,7 @@ static int qca_check_speeds(struct hci_uart *hu)
 	case QCA_WCN6750:
 	case QCA_WCN6855:
 	case QCA_WCN7850:
+	case QCA_WCN7750:
 	case QCA_WCN7860:
 		if (!qca_get_speed(hu, QCA_INIT_SPEED) &&
 		    !qca_get_speed(hu, QCA_OPER_SPEED))
@@ -1547,6 +1549,7 @@ static int qca_set_speed(struct hci_uart *hu, enum qca_speed_type speed_type)
 		case QCA_WCN6750:
 		case QCA_WCN6855:
 		case QCA_WCN7850:
+		case QCA_WCN7750:
 		case QCA_WCN7860:
 			hci_uart_set_flow_control(hu, true);
 			break;
@@ -1584,6 +1587,7 @@ static int qca_set_speed(struct hci_uart *hu, enum qca_speed_type speed_type)
 		case QCA_WCN6750:
 		case QCA_WCN6855:
 		case QCA_WCN7850:
+		case QCA_WCN7750:
 		case QCA_WCN7860:
 			hci_uart_set_flow_control(hu, false);
 			break;
@@ -1902,6 +1906,7 @@ static int qca_power_on(struct hci_dev *hdev)
 	case QCA_WCN6750:
 	case QCA_WCN6855:
 	case QCA_WCN7850:
+	case QCA_WCN7750:
 	case QCA_WCN7860:
 		ret = qca_regulator_init(hu);
 		break;
@@ -2002,6 +2007,10 @@ static int qca_setup(struct hci_uart *hu)
 		soc_name = "wcn7850";
 		break;
 
+	case QCA_WCN7750:
+		soc_name = "wcn7750";
+		break;
+
 	case QCA_WCN7860:
 		soc_name = "wcn7860";
 		break;
@@ -2029,6 +2038,7 @@ static int qca_setup(struct hci_uart *hu)
 	case QCA_WCN6750:
 	case QCA_WCN6855:
 	case QCA_WCN7850:
+	case QCA_WCN7750:
 	case QCA_WCN7860:
 		if (qcadev && qcadev->bdaddr_property_broken)
 			hci_set_quirk(hdev, HCI_QUIRK_BDADDR_PROPERTY_BROKEN);
@@ -2069,6 +2079,7 @@ static int qca_setup(struct hci_uart *hu)
 	case QCA_WCN6750:
 	case QCA_WCN6855:
 	case QCA_WCN7850:
+	case QCA_WCN7750:
 	case QCA_WCN7860:
 		break;
 
@@ -2286,6 +2297,23 @@ static const struct qca_device_data qca_soc_data_wcn7860 __maybe_unused = {
 			QCA_CAP_HFP_HW_OFFLOAD,
 };
 
+static const struct qca_device_data qca_soc_data_wcn7750 __maybe_unused = {
+	.soc_type = QCA_WCN7750,
+	.vregs = (struct qca_vreg []) {
+		{ "vddio", 5000 },
+		{ "vddaon", 26000 },
+		{ "vdddig", 126000 },
+		{ "vddrfacmn", 12500 },
+		{ "vddrfa0p8", 102000 },
+		{ "vddrfa1p2", 257000 },
+		{ "vddrfa1p9", 302000 },
+		{ "vddrfa2p2", 1700000 },
+	},
+	.num_vregs = 8,
+	.capabilities = QCA_CAP_WIDEBAND_SPEECH | QCA_CAP_VALID_LE_STATES |
+			QCA_CAP_HFP_HW_OFFLOAD,
+};
+
 static void qca_power_off(struct hci_uart *hu)
 {
 	struct qca_serdev *qcadev;
@@ -2517,6 +2545,7 @@ static int qca_serdev_probe(struct serdev_device *serdev)
 	case QCA_WCN6750:
 	case QCA_WCN6855:
 	case QCA_WCN7850:
+	case QCA_WCN7750:
 	case QCA_WCN7860:
 		qcadev->bt_power = devm_kzalloc(&serdev->dev,
 						sizeof(struct qca_power),
@@ -2537,6 +2566,7 @@ static int qca_serdev_probe(struct serdev_device *serdev)
 	case QCA_WCN6750:
 	case QCA_WCN6855:
 	case QCA_WCN7850:
+	case QCA_WCN7750:
 	case QCA_WCN7860:
 		if (!device_property_present(&serdev->dev, "enable-gpios")) {
 			/*
@@ -2580,6 +2610,7 @@ static int qca_serdev_probe(struct serdev_device *serdev)
 		if (!qcadev->bt_en &&
 		    (data->soc_type == QCA_WCN6750 ||
 		     data->soc_type == QCA_WCN6855 ||
+		     data->soc_type == QCA_WCN7750 ||
 		     data->soc_type == QCA_WCN7850))
 			bt_en_available = false;
 
@@ -2588,6 +2619,7 @@ static int qca_serdev_probe(struct serdev_device *serdev)
 		if (IS_ERR(qcadev->sw_ctrl) &&
 		    (data->soc_type == QCA_WCN6750 ||
 		     data->soc_type == QCA_WCN6855 ||
+		     data->soc_type == QCA_WCN7750 ||
 		     data->soc_type == QCA_WCN7850 ||
 		     data->soc_type == QCA_WCN7860)) {
 			dev_err(&serdev->dev, "failed to acquire SW_CTRL gpio\n");
@@ -2688,6 +2720,7 @@ static void qca_serdev_remove(struct serdev_device *serdev)
 	case QCA_WCN6750:
 	case QCA_WCN6855:
 	case QCA_WCN7850:
+	case QCA_WCN7750:
 	case QCA_WCN7860:
 		if (power->vregs_on)
 			qca_power_off(&qcadev->serdev_hu);
@@ -2895,6 +2928,7 @@ static const struct of_device_id qca_bluetooth_of_match[] = {
 	{ .compatible = "qcom,wcn6855-bt", .data = &qca_soc_data_wcn6855},
 	{ .compatible = "qcom,wcn7850-bt", .data = &qca_soc_data_wcn7850},
 	{ .compatible = "qcom,wcn7860-bt", .data = &qca_soc_data_wcn7860},
+	{ .compatible = "qcom,wcn7750-bt", .data = &qca_soc_data_wcn7750},
 	{ /* sentinel */ }
 };
 MODULE_DEVICE_TABLE(of, qca_bluetooth_of_match);
