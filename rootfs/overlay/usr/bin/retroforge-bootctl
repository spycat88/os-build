#!/usr/bin/env bash
# retroforge-bootctl — RAUC's bootloader backend, the boot-health confirmation, and a by-hand view
# of the slot state.
#
# The slot state is the Boot Loader Specification entries OpenABL boots, each on its slot's own
# boot partition (rootfs/overlay/usr/lib/retroforge/install/lib-bls.sh has the whole layout): each
# slot's entry carries a +N boot counter in its file name, and the ESP's \loader\loader.conf
# `default` names the primary slot. /etc/rauc/system.conf says bootloader=custom with this file as the backend, so RAUC calls
# the first five commands below itself, with the slot's bootname (A or B).
#
#   get-current      the slot this system booted (A|B), from the initramfs handoff.
#   get-primary      the slot OpenABL boots next: the loader.conf default if it has tries left,
#                    else the other slot if it has.
#   set-primary <self|A|B>
#                    boot that slot next: its counter back to three tries, and the loader.conf
#                    default. A slot with no entry yet (mid-install) only gets the default; the
#                    update hook writes its entry once the slot is bootable.
#   get-state <self|A|B>
#                    good while the slot's entry has tries left, bad when it has none or no entry.
#   set-state <self|A|B> <good|bad>
#                    good: the counter back to three tries. bad: to none, so the next boot goes to
#                    the other slot. retroforge-boot-bad.service demotes with `set-state self bad`.
#   mark-good [--require-marker] [--wait SECONDS]
#                    confirm THIS boot (retroforge-boot-good.service): on a fresh card's first
#                    boot, write the slot and debug entries for the board it came up on and drop
#                    the setup entries; then rauc status mark-good booted, which comes back here as
#                    set-state <slot> good.
#        --require-marker  re-test the session marker before confirming; without it, exit 1
#        --wait SECONDS    hold that long first, and exit 0 WITHOUT a verdict if signalled
#                          during the wait (a shutdown is not evidence of a bad boot)
#   status           the entries, the default, and what boots next.
#
# THE CONTRACT IS THE EXIT STATUS, as RAUC's custom backend interface has it: non-zero is failure,
# so every legal call exits 0 -- including no-ops. tests/test-bootctl.sh executes THIS file (not a
# copy) against a sandbox ESP and a stubbed rauc.
#
# Who decides what:
#   * "Is this slot OK?" is the OS's call. The boot service confirms (mark-good); a failed health
#     check demotes (retroforge-boot-bad.service -> set-state self bad). The bootloader never does.
#   * "Did a slot fail to come up?" is OpenABL's boot counting: three boots without a mark-good and
#     the slot has no tries left, so OpenABL boots the other one.
set -euo pipefail

# TEST SEAMS. BOOTINFO is the initramfs handoff (image/initramfs/init writes it on every boot,
# including degraded ones); mark-good uses it to tell a slot boot from a cmdline-fallback boot.
# SESSION_MARKER is the ready marker retroforge-boot-good.path watches. RAUC is the one external
# tool. ESP is the shared ESP, BOOTPARTS where the two slots' boot partitions are mounted (<BOOTPARTS>/a
# and /b, automounted by /etc/fstab), BOOTDIR this root's boot payload (board table, command line,
# release, OpenABL's DTBs), and DEVDIR the boot disk's partition links the slot entries' PARTUUIDs
# are read from. lib-bls.sh adds two of its own: BLKID and DT_MODEL.
BOOTINFO=${BOOTINFO:-/run/retroforge/boot}
SESSION_MARKER=${SESSION_MARKER:-/run/retroforge/session/ready}
RAUC=${RAUC:-rauc}
ESP=${ESP:-/esp}
BOOTPARTS=${BOOTPARTS:-/run/retroforge/bootfs}
BOOTDIR=${BOOTDIR:-/usr/lib/retroforge/boot}
DEVDIR=${DEVDIR:-/dev/retroforge}

PROG=${0##*/}
die()  { printf '%s: %s\n' "$PROG" "$*" >&2; exit 1; }
warn() { printf '%s: WARNING: %s\n' "$PROG" "$*" >&2; }
log()  { printf '%s: %s\n' "$PROG" "$*"; }

# The boot entry writers are shared with the update hook and the installer, resolved relative to
# this file because rootfs/overlay mirrors the device layout (/usr/bin/../lib/retroforge/install).
LIBDIR="$(cd "$(dirname "$0")" && pwd)/../lib/retroforge/install"
[ -r "$LIBDIR/lib-bls.sh" ] || die "cannot read $LIBDIR/lib-bls.sh"
# shellcheck source=../lib/retroforge/install/lib-bls.sh
. "$LIBDIR/lib-bls.sh"

booted_slot() {  # -> A|B, or "" when this boot did not come from a slot
  sed -n 's/^slot=//p' "$BOOTINFO" 2>/dev/null || true
}

resolve_slot() {  # <self|A|B> -> A|B
  case ${1:-} in
    self)
      local s; s=$(booted_slot)
      case $s in A|B) echo "$s" ;; *) die "this boot did not come from a slot (no slot= in $BOOTINFO)" ;; esac ;;
    A|B) echo "$1" ;;
    *) die "invalid slot '${1:-}' (expected A, B or self)" ;;
  esac
}

esp_ready() {
  ls "$ESP" >/dev/null 2>&1 || true        # trigger the fstab automount if it is not up
  [ -d "$ESP" ] || die "no ESP at $ESP"
}

slotfs() {  # <A|B> -> where that slot's boot partition is mounted
  local d; d="$BOOTPARTS/$(bls_lc "$1")"
  ls "$d" >/dev/null 2>&1 || true          # trigger the fstab automount
  [ -d "$d" ] || die "slot $1's boot partition is not mounted at $d"
  printf '%s\n' "$d"
}

primary() { bls_primary "$ESP" "$(slotfs A)" "$(slotfs B)"; }

# --- slot state ---------------------------------------------------------------------------------

get_current() {
  local s; s=$(booted_slot)
  case $s in
    A|B) echo "$s" ;;
    *) die "this boot did not come from a slot (no slot= in $BOOTINFO)" ;;
  esac
}

get_primary() {
  esp_ready
  primary || die "neither slot has an entry with tries left"
}

get_state() {  # <self|A|B>
  local s; s=$(resolve_slot "${1:-}")
  bls_state "$(slotfs "$s")" "$s"
}

set_state() {  # <self|A|B> <good|bad>
  local s fs; s=$(resolve_slot "${1:-}")
  fs=$(slotfs "$s")
  case ${2:-} in
    good)
      bls_set_tries "$fs" "$s" "$BLS_TRIES" \
        || die "slot $s has no boot entry on $fs -- it cannot be good" ;;
    bad)
      # No entry is already as bad as it gets.
      bls_set_tries "$fs" "$s" 0 || log "slot $s has no boot entry; nothing to demote" ;;
    *) die "bad slot state value '${2:-}' (expected good or bad)" ;;
  esac
}

set_primary() {  # <self|A|B>
  local s; s=$(resolve_slot "${1:-}")
  esp_ready
  bls_set_tries "$(slotfs "$s")" "$s" "$BLS_TRIES" \
    || log "slot $s has no boot entry yet; only the default moves"
  bls_set_default "$ESP" "$s"
}

# --- the first boot of a fresh card -------------------------------------------------------------
# A card leaves the build with setup entries on boot-a, one per board, because one image serves every
# board and only the user can say which this is (lib-bls.sh). The boot being confirmed came from one
# of them, so the running devicetree names the board: write the slot and debug entries for it, for
# every slot the card carries files for, make the booted slot the default, and only then drop the
# setup entries -- an interruption anywhere before that leaves the menu, never nothing.
#
# Each slot's entries come from the boot data of the root in THAT slot, which on a card is the same
# build in both; the running root's is what is readable here, and the card is fresh, so it is used
# for both.
commit_board() {  # <booted-slot>
  local booted="$1" s fs text debug root var n=0
  for s in A B; do
    fs=$(slotfs "$s")
    bls_slot_files_present "$fs" || continue
    root=$(bls_dev_partuuid "$DEVDIR/retroforge-root-$s")
    var=$(bls_dev_partuuid "$DEVDIR/retroforge-var-$s")
    text=$(bls_device_entry "$BOOTDIR" "$s" "$root" "$var")
    debug=$(bls_device_entry "$BOOTDIR" "$s" "$root" "$var" debug)
    bls_write_debug "$fs" "$s" "$debug"$'\n'
    bls_write_entry "$fs" "$s" "$text"$'\n'
    log "slot $s: boot entries written ($BLS_ENTRIES/$(bls_entry_name "$s" "$BLS_TRIES"), $(bls_debug_name "$s"))"
    n=$((n + 1))
  done
  bls_entry_file "$(slotfs "$booted")" "$booted" >/dev/null || die "slot $booted has no kernel on its boot partition -- cannot write its entry"
  bls_set_default "$ESP" "$booted"
  bls_remove_setup "$(slotfs A)"
  bls_remove_setup "$(slotfs B)"
  log "board '$(bls_running_model)' committed: $n slot entr$([ "$n" = 1 ] && echo y || echo ies), setup entries removed"
}

# --- boot health --------------------------------------------------------------------------------

# Confirm this boot, called by retroforge-boot-good.service after the session handshake plus a
# --wait re-check. Exiting 0 here is load-bearing on a degraded boot: retroforge-boot-good.service is
# RemainAfterExit=yes so it fires once per boot, and a non-zero exit re-arms the level-triggered
# .path into a failing mark-good every 30s for the rest of the device's uptime (measured on
# hardware in 2026-07, before the handoff guard existed). The handoff names no slot on a
# cmdline-fallback boot, so that is the guard: nothing to confirm -> 0.
#
# --wait OWNS THE RE-CHECK DELAY, and it is here rather than in the unit because being interrupted
# mid-wait must not be a verdict: a SIGTERM'd ExecStartPre sleep is scored `Failed with result
# 'signal'` and fires OnFailure=retroforge-boot-bad.service (HW-observed 2026-08-10). Trapping the
# signal turns "the system went down before we could judge" into no verdict: nothing is confirmed,
# nothing is demoted, and the next boot runs the whole check again.
mark_good() {
  local require_marker=0 wait_secs=0
  while [ $# -gt 0 ]; do
    case $1 in
      --require-marker) require_marker=1 ;;
      --wait) shift; wait_secs=${1:-} ;;
      *) die "mark-good: unknown option '$1'" ;;
    esac
    shift
  done
  case $wait_secs in
    ''|*[!0-9]*) die "mark-good: --wait needs a whole number of seconds, got '${wait_secs}'" ;;
  esac

  local bs src
  bs=$(booted_slot)
  src=$(sed -n 's/^source=//p' "$BOOTINFO" 2>/dev/null || true)
  if [ -z "$bs" ]; then
    echo "this boot did not come from a slot (source=${src:-unknown}) -- nothing to confirm"
    return 0
  fi

  # `sleep` is backgrounded and waited on because bash defers a trap until the current FOREGROUND
  # command returns -- a foreground sleep would swallow the signal for the rest of the window.
  if [ "$wait_secs" -gt 0 ]; then
    local interrupted=0
    trap 'interrupted=1' TERM INT
    sleep "$wait_secs" & wait $! || true
    trap - TERM INT
    if [ "$interrupted" = 1 ]; then
      echo "interrupted during the ${wait_secs}s re-check -- not confirming, not demoting"
      return 0
    fi
  fi

  if [ "$require_marker" = 1 ] && [ ! -e "$SESSION_MARKER" ]; then
    die "no session marker at $SESSION_MARKER -- refusing to confirm this boot"
  fi

  esp_ready
  if ! bls_entry_file "$(slotfs "$bs")" "$bs" >/dev/null || bls_has_setup "$(slotfs A)"; then
    commit_board "$bs"
  fi

  "$RAUC" status mark-good booted || die "rauc status mark-good booted failed"
  echo "boot confirmed good (slot $bs)"
}

# --- diagnostics --------------------------------------------------------------------------------

status() {
  local f s fs
  echo "booted slot: $(booted_slot || true)"
  ls "$ESP" >/dev/null 2>&1 || true
  for s in A B; do
    fs="$BOOTPARTS/$(bls_lc "$s")"
    ls "$fs" >/dev/null 2>&1 || true
    echo "slot $s:      $(bls_state "$fs" "$s")  ($fs/$BLS_ENTRIES)"
    for f in "$fs/$BLS_ENTRIES"/*.conf; do
      [ -e "$f" ] && echo "  ${f##*/}"
    done
  done
  echo "default:     $(bls_default "$ESP")"
  bls_has_setup "$BOOTPARTS/a" && echo "setup:       the board is not committed yet (fresh card)"
  echo "next boot:   $(bls_primary "$ESP" "$BOOTPARTS/a" "$BOOTPARTS/b" 2>/dev/null || echo '<undetermined>')"
}

usage() {
  # The header comment IS the usage text, printed to wherever it ends.
  awk 'NR == 1 { next }                      # shebang
       /^#/    { sub(/^# ?/, ""); print; next }
               { exit }' "$0"
  exit 2
}

case "${1:-}" in
  get-current) shift; get_current ;;
  get-primary) shift; get_primary ;;
  set-primary) shift; set_primary "$@" ;;
  get-state)   shift; get_state "$@" ;;
  set-state)   shift; set_state "$@" ;;
  mark-good)   shift; mark_good "$@" ;;
  status)      shift; status ;;
  ''|-h|--help|help) usage ;;
  *) die "unknown command: $1 (try --help)" ;;
esac
