# Once-per-boot device report (usr/bin/retroforge-telemetry; docs/telemetry.md).
#
# Up to three attempts, five minutes apart, then the process exits: on the first success, or after
# the third failure until the next boot. The retry loop lives in the program, so Restart=no — systemd
# must not add attempts the policy does not have. Type=exec rather than oneshot so the unit is
# "active" while it waits and never holds up multi-user.target (a oneshot would block boot for up to
# ten minutes on a device with no network).
#
# CONSENT GATE. It runs only after the user said yes on the first-boot consent screen (OpenGamepadUI
# patch 0060), which writes TELEMETRY=on|off to ~player/.config/retroforge/telemetry.conf. The
# ExecCondition asks the program, which also honours an off in /etc/retroforge/telemetry.conf or
# retroforge.telemetry=0 on the cmdline: without a yes systemd skips the unit and nothing else runs.
#
# Started at boot (multi-user.target) and by retroforge-telemetry.path when the answer is written,
# so the first report follows the setup screen instead of waiting for the second boot.
[Unit]
Description=RetroForge anonymous device report
Wants=network-online.target
After=network-online.target time-sync.target home.mount

[Service]
Type=exec
ExecCondition=/usr/bin/retroforge-telemetry consented
ExecStart=/usr/bin/retroforge-telemetry run
Restart=no
Nice=10
# Reads /sys, /proc and two config files, writes one state file. Nothing else.
StateDirectory=retroforge
ProtectSystem=strict
ReadWritePaths=/var/lib/retroforge
ProtectHome=read-only
PrivateTmp=yes
NoNewPrivileges=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=multi-user.target
