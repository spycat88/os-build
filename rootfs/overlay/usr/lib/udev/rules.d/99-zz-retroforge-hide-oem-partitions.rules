# Keep systemd blind to the internal storage's OWN partitions.
#
# A handheld's eMMC or UFS carries the vendor's partitions (super, vbmeta, xbl, userdata, ...): 85 on
# the Air X MQ66. With the systemd tag every one becomes a .device unit plus one per by-* alias, 1188
# device units in all there, and every service manager loads them all when it starts. The session
# user's manager spent most of its 2.4s startup doing exactly that, on the path to the session, and
# the same tag spawned a retroforge-automount job per partition that had nothing to mount (measured
# 2026-10-31: a dry run of that manager went from 4.9s to 2.0s with these hidden).
#
# SYSTEMD_READY=0 removes only the systemd units. The /dev nodes, the by-* links and the udev
# database stay, which is what lsblk, blkid, udisks and the internal installer read (rmtfs opens
# modemst1/modemst2/fsg by-partlabel, never through a unit).
#
# NOT TAG-="systemd", which this first was. systemd 260 drops the tag from the database but leaves
# the event's CURRENT_TAGS property stale when the last current tag goes, so PID1, which reads the
# event, still saw every partition as ready (Air X: 170 units left, and the automount jobs ran).
#
# 99-zz so it runs after systemd's 99-systemd.rules. Our own partitions (retroforge-*/RETROFORGE,
# an internal install's) are never matched, and neither is anything that is not internal storage:
# SD cards and USB disks keep their units and their automount.
ACTION=="remove", GOTO="retroforge_hide_oem_end"
SUBSYSTEM!="block", GOTO="retroforge_hide_oem_end"
ENV{DEVTYPE}!="partition", GOTO="retroforge_hide_oem_end"
ENV{ID_PART_ENTRY_NAME}=="retroforge-*|RETROFORGE", GOTO="retroforge_hide_oem_end"

# eMMC (the SM6115 boards): the MMC core types an eMMC "MMC" and an SD card "SD".
KERNEL=="mmcblk*p*", ATTRS{type}=="MMC", ENV{SYSTEMD_READY}="0"
# UFS (the SM8xxx boards): the host controller is in the device path.
KERNEL=="sd*", ENV{ID_PATH}=="*ufs*", ENV{SYSTEMD_READY}="0"

LABEL="retroforge_hide_oem_end"
