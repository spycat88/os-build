# retroforge: /dev/retroforge/<GPT name> — the by-partlabel links, scoped to the disk we booted from.
#
# The whole rationale is in /usr/lib/retroforge/on-boot-disk, which decides the match. In one line:
# every retroforge medium carries the same eight GPT names, so /dev/disk/by-partlabel/* and
# /dev/disk/by-label/* name an arbitrary disk once a card is inserted in a device that is installed
# to internal storage — and the four things the RUNNING system resolves by name (/esp, /home,
# grow-home's repart target, and rauc's slot devices) all followed that arbitrary choice.
#
# 69-, NOT 60-. ID_PART_ENTRY_NAME is exported by the blkid builtin that 60-persistent-storage.rules
# imports, and udev sorts rule FILES lexically across every rules directory: "60-retroforge-bootdisk"
# sorts before "60-persistent-storage", so at 60 this would match an unset variable and silently
# link nothing. 69 is after that import and still before the 70- input rules this tree already ships.
#
# The name is copied through verbatim rather than mapped to a short role, so this file enumerates
# NOTHING and cannot drift from image/partition-table.txt. Adding a ninth partition needs no edit
# here; it needs one at the consumer that wants to name it.

ACTION=="remove", GOTO="retroforge_bootdisk_end"
SUBSYSTEM!="block", GOTO="retroforge_bootdisk_end"
ENV{DEVTYPE}!="partition", GOTO="retroforge_bootdisk_end"
ENV{ID_PART_ENTRY_SCHEME}!="gpt", GOTO="retroforge_bootdisk_end"
ENV{ID_PART_ENTRY_NAME}!="retroforge-*|RetroForge|RETROFORGE-*", GOTO="retroforge_bootdisk_end"

# THE ONE ALIAS. The ESP's GPT name was RETROFORGE-ESP until 2026-11-11 and is RetroForge now, and
# /etc/fstab names only the new one. A card flashed before the rename keeps the old name after an
# OTA (nothing rewrites a running disk's GPT), so it is linked under BOTH names; without this it would
# boot with no /esp, never see its grubenv, and fail every update back. Before the main rule, so the
# RESULT below is the main rule's.
ENV{ID_PART_ENTRY_NAME}=="RETROFORGE-ESP", PROGRAM=="/usr/lib/retroforge/on-boot-disk %k", SYMLINK+="retroforge/RetroForge"

# PROGRAM is a MATCH key: the SYMLINK is added only on exit 0. on-boot-disk exits 0 for "on the boot
# disk" AND for "the boot disk cannot be determined" — see its header for why the second is
# deliberate, and why it is the only behaviour that cannot regress a single-disk device.
PROGRAM=="/usr/lib/retroforge/on-boot-disk %k", SYMLINK+="retroforge/$env{ID_PART_ENTRY_NAME}"
# It prints "boot" only for the first, so this marks the partitions known to be on the boot disk and
# never a "cannot tell". 99-retroforge-automount.rules skips them, as automount.sh would.
RESULT=="boot", ENV{RETROFORGE_BOOT_DISK}="1"

LABEL="retroforge_bootdisk_end"
