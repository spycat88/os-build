 core/ui/card_ui/settings/disks_settings_menu.tscn |   3 +-
 core/ui/components/drive_card.gd                  |  32 +++++
 core/ui/components/partition_card.gd              |  23 ++++
 4 files changed, 173 insertions(+), 21 deletions(-)

diff --git a/core/ui/card_ui/settings/disks_settings_menu.gd b/core/ui/card_ui/settings/disks_settings_menu.gd
index 9dfef94..14373c0 100644
--- a/core/ui/card_ui/settings/disks_settings_menu.gd
+++ b/core/ui/card_ui/settings/disks_settings_menu.gd
@@ -11,10 +11,16 @@ var logger := Log.get_logger("DisksMenu", Log.LEVEL.INFO)
 @onready var focus_group: FocusGroup = $%FocusGroup
 @onready var no_drive_label: Label = $%NoDisksLabel
 
-## Whether the drive cards are out of date. They are built only while the menu is shown: a
-## handheld's internal storage alone is ~85 vendor partitions, a card each, and listing and
-## building them (twice, as udisks2 settles) held the shell's first frame back ~2 s at boot.
-var _stale := true
+## The only mount points the menu shows, each on its drive's card when mounted: RetroForge's own
+## partitions (the btrfs root, the slot's /var and /efi, the shared ESP, the player's /home) and
+## its SD card (the [sdcard] share's bind of the card's own mount). Everything else, a handheld's
+## ~85 vendor partitions among it, is left out.
+const SHOWN_MOUNTS: PackedStringArray = ["/", "/var", "/efi", "/esp", "/home", "/run/retroforge/sdcard"]
+
+# The drive cards are built only while the menu is shown: a handheld's internal storage alone is
+# ~85 vendor partitions, and listing them (twice, as udisks2 settles) held the shell's first frame
+# back ~2 s at boot. They are rebuilt each time it is shown, as UDisks2Instance signals a device
+# added or removed but not a mount or an unmount, and the SD card is mounted after it is added.
 
 
 # Called when the node enters the scene tree for the first time.
@@ -27,22 +33,20 @@ func _ready():
 	_refresh()
 
 
-func _on_devices_updated(devices: Array[BlockDevice]) -> void:
+func _on_devices_updated(_devices: Array[BlockDevice]) -> void:
 	if is_visible_in_tree():
-		_on_drives_updated(devices)
-	else:
-		_stale = true
+		_refresh()
 
 
 func _refresh() -> void:
-	if not _stale or not is_visible_in_tree():
+	if not is_visible_in_tree():
 		return
-	_on_drives_updated(udisks2.get_unprotected_devices())
