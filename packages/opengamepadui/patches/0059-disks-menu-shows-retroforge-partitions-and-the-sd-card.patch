+
+
+## Shows the mounted filesystem's size and free space as `df -h` does (binary units), instead
+## of the partition's size in decimal units (a 256 MiB /var showed as "268.44 MB", df "224M").
+func _show_filesystem_size() -> void:
+	var filesystem := partition_device.get_filesystem()
+	if not filesystem:
+		return
+	var mounts := filesystem.get_mounts()
+	if mounts.is_empty():
+		return
+	var output := []
+	if OS.execute("df", ["-B1", "--output=size,avail", "--", mounts[0]], output) != 0 or output.is_empty():
+		return
+	# "     1B-blocks        Avail\n     234620928    190115840\n"
+	var lines := (output[0] as String).split("\n", false)
+	if lines.size() < 2:
+		return
+	var fields := lines[1].split(" ", false)
+	if fields.size() < 2 or not fields[0].is_valid_int() or not fields[1].is_valid_int():
+		return
+	size_label.text = "%s (%s free)" % [DriveCard.human_size(fields[0].to_int()), DriveCard.human_size(fields[1].to_int())]
