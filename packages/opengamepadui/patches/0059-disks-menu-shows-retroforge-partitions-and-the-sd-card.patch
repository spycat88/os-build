 	_set_icon()
 	_populate_partitions()
 
@@ -170,6 +178,27 @@ func _clear_partitions() -> void:
 		child.queue_free()
 
 
+## Returns a size in bytes as `df -h` writes it: powers of 1024, rounded up, one decimal below
+## 10 (224M, 9.6G, 1.0T).
+static func human_size(bytes: int) -> String:
+	const UNITS: PackedStringArray = ["K", "M", "G", "T", "P", "E"]
+	if bytes < 1024:
+		return str(bytes)
+	var value := float(bytes)
+	var unit := -1
+	while value >= 1024.0 and unit < UNITS.size() - 1:
+		value /= 1024.0
+		unit += 1
+	if value < 10.0:
+		value = ceilf(value * 10.0) / 10.0
+		if value < 10.0:
+			return "%.1f%s" % [value, UNITS[unit]]
+	value = ceilf(value)
+	if value >= 1024.0 and unit < UNITS.size() - 1:
+		return "1.0" + UNITS[unit + 1]
+	return "%d%s" % [int(value), UNITS[unit]]
+
+
 ## Populates the partition grid with an item for every PartitionDevice on this BlockDevice
 func _populate_partitions() -> void:
 	_clear_partitions()
@@ -180,6 +209,9 @@ func _populate_partitions() -> void:
 		if partition.partition_name.contains("/dev/loop"):
 			continue
 
+		if not shown_partitions.is_empty() and not shown_partitions.has(partition.dbus_path):
+			continue
+
 		logger.debug("Drive has partition to set up:", partition.dbus_path)
 		var partition_card := partition_card_scene.instantiate() as PartitionCard
 		partitions_container.add_child(partition_card)
