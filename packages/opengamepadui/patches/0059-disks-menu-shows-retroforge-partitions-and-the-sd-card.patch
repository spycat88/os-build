 		no_drive_label.visible = true
 		container.visible = false
 		return
@@ -63,16 +67,13 @@ func _on_drives_updated(devices: Array[BlockDevice]) -> void:
 
 	# Poplulate drives
 	var last_focus: FocusGroup
-	for drive in devices:
-		var drive_type = drive.dbus_path.trim_prefix(steam_disks.BLOCK_PREFIX)
-
-		# Ignore loop devices
-		if drive_type.contains("loop"):
-			continue
+	for disk_path in drives:
+		var drive := load("dbus://org.freedesktop.UDisks2" + disk_path) as BlockDevice
 
 		# Create Drive Card
 		var drive_card := drive_card_scene.instantiate() as DriveCard
 		container.add_child(drive_card)
+		drive_card.shown_partitions = drives[disk_path]
 		drive_card.setup(drive)
 		drive_card.visible = true
 
@@ -82,3 +83,100 @@ func _on_drives_updated(devices: Array[BlockDevice]) -> void:
 			last_focus.focus_neighbor_bottom = drive_focus
 			drive_focus.focus_neighbor_top = last_focus
 		last_focus = drive_focus
+
+
+## Returns the drives that hold a mounted SHOWN_MOUNTS, as {disk dbus path: PackedStringArray of
+## the dbus paths of its partitions to show}, in SHOWN_MOUNTS order. A drive without a partition
+## table (a card formatted whole) has no partitions to list.
+func _get_shown_drives() -> Dictionary:
+	var drives := {}
+	var devices := _get_mount_devices()
+	for mount in SHOWN_MOUNTS:
+		if not (mount in devices):
+			continue
+		var uevent := _get_block_uevent(devices[mount])
+		var dev_name: String = uevent.get("DEVNAME", "")
+		if dev_name.is_empty():
+			logger.debug("No block device for " + mount)
+			continue
+
+		# A partition's disk is its name without the partition number, and the "p" the kernel
+		# puts before it when the disk's name ends in a digit (mmcblk0p1, nvme0n1p3, sda1).
+		var disk := dev_name
+		var partition := ""
+		var partn: String = uevent.get("PARTN", "")
+		if uevent.get("DEVTYPE", "") == "partition" and not partn.is_empty() and dev_name.ends_with(partn):
+			disk = dev_name.substr(0, dev_name.length() - partn.length())
+			if disk.length() > 2 and disk.ends_with("p") and disk[disk.length() - 2].is_valid_int():
+				disk = disk.substr(0, disk.length() - 1)
+			partition = steam_disks.BLOCK_PREFIX + "/" + dev_name
+
+		# UDisks2Instance holds a BlockDevice for every block device, cached under this path
+		var disk_path := steam_disks.BLOCK_PREFIX + "/" + disk
+		if not ResourceLoader.exists("dbus://org.freedesktop.UDisks2" + disk_path):
+			logger.debug("UDisks2 has no block device " + disk_path + " for " + mount)
+			continue
+
+		# Packed arrays are copied out of a Dictionary, so the list is put back after the append
+		var partitions: PackedStringArray = drives.get(disk_path, PackedStringArray())
+		if not partition.is_empty() and not partitions.has(partition):
+			partitions.append(partition)
+		drives[disk_path] = partitions
+
+	return drives
+
+
+## Returns the uevent of the block device behind a mountinfo entry, [major:minor, source]: by its
+## device number, or for btrfs (whose device number is an anonymous 0:N) by its source, a /dev
+## node or a symlink to one (/dev/retroforge/*, /dev/disk/by-*). Empty when neither is a block device.
+func _get_block_uevent(entry: PackedStringArray) -> Dictionary:
+	var uevent := _read_uevent("/sys/dev/block/%s/uevent" % entry[0])
+	if not uevent.is_empty():
+		return uevent
+
+	var source := entry[1]
+	if not source.begins_with("/dev/"):
+		return uevent
+	for _i in 8:
+		var dir := DirAccess.open(source.get_base_dir())
+		if not dir or not dir.is_link(source):
+			break
+		var target := dir.read_link(source)
+		if not target.is_absolute_path():
+			target = source.get_base_dir().path_join(target)
+		source = target.simplify_path()
+	return _read_uevent("/sys/class/block/%s/uevent" % source.get_file())
+
+
+## Returns {mount point: [major:minor, source]} for the mount points in SHOWN_MOUNTS, from this
+## process's mount table (the last, topmost, mount at a path wins).
+func _get_mount_devices() -> Dictionary:
+	var devices := {}
+	# Read line by line: /proc files report a length of 0, so a read by length gets nothing.
+	var file := FileAccess.open("/proc/self/mountinfo", FileAccess.READ)
+	if not file:
+		return devices
+	while not file.eof_reached():
+		# 36 35 179:5 / /home rw,relatime shared:12 - ext4 /dev/mmcblk0p5 rw
+		var fields := file.get_line().split(" ", false)
+		var separator := fields.find("-", 6)
+		if separator < 0 or fields.size() < separator + 3:
+			continue
+		var mount_point := fields[4]
+		if mount_point in SHOWN_MOUNTS:
+			devices[mount_point] = PackedStringArray([fields[2], fields[separator + 2]])
+	return devices
+
+
+## Returns a sysfs uevent file's KEY=value lines as a Dictionary
+func _read_uevent(path: String) -> Dictionary:
+	var uevent := {}
+	var file := FileAccess.open(path, FileAccess.READ)
+	if not file:
+		return uevent
+	while not file.eof_reached():
+		var line := file.get_line()
+		var eq := line.find("=")
+		if eq > 0:
+			uevent[line.left(eq)] = line.substr(eq + 1)
+	return uevent
