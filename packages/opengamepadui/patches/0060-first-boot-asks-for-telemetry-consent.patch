--- /dev/null
+++ b/core/ui/card_ui/ootbe/telemetry_select.gd
@@ -0,0 +1,55 @@
+extends MarginContainer
+## RetroForge: first-boot consent to the anonymous device report (retroforge-telemetry).
+##
+## The answer is written to the file the report reads, TELEMETRY=on or TELEMETRY=off in
+## ~/.config/retroforge/telemetry.conf, when Next is pressed, and only then. Until a user has
+## answered here (or with `retroforge-telemetry enable`) there is no file and nothing is ever sent:
+## the report needs a recorded yes, not the absence of a no. The toggle starts on.
+
+const CONSENT_KEY := "TELEMETRY"
+
+var state_machine := load("res://assets/state/state_machines/first_boot_state_machine.tres") as StateMachine
+var finished_state := load("res://assets/state/states/first_boot_finished.tres") as State
+
+var logger := Log.get_logger("TelemetrySelect")
+
+@onready var toggle := $%TelemetryToggle as Toggle
+@onready var next_button := $%NextButton as CardButton
+
+
+func _ready() -> void:
+	toggle.button_pressed = true
+	next_button.button_up.connect(_on_next_button)
+
+
+func _on_next_button() -> void:
+	save_consent(toggle.button_pressed)
+	state_machine.push_state(finished_state)
+
+
+## Where the answer is kept: the user's half of /home, which both A/B slots share, so it survives
+## every update. RETROFORGE_TELEMETRY_USER_CONFIG is the client's own override of the same path.
+static func consent_path() -> String:
+	var path := OS.get_environment("RETROFORGE_TELEMETRY_USER_CONFIG")
+	if path.is_empty():
+		path = OS.get_environment("HOME").path_join(".config/retroforge/telemetry.conf")
+	return path
+
+
+static func save_consent(on: bool) -> bool:
+	var path := consent_path()
+	DirAccess.make_dir_recursive_absolute(path.get_base_dir())
+	var tmp := path + ".tmp"
+	var file := FileAccess.open(tmp, FileAccess.WRITE)
+	if file == null:
+		Log.get_logger("TelemetrySelect").error("cannot write " + tmp + ": " + str(FileAccess.get_open_error()))
+		return false
+	file.store_string("# Written by the first-boot setup. TELEMETRY=off stops the boot report; `retroforge-telemetry enable|disable` changes it.\n")
+	file.store_string(CONSENT_KEY + "=" + ("on" if on else "off") + "\n")
+	file.close()
+	var err := DirAccess.rename_absolute(tmp, path)
+	if err != OK:
+		Log.get_logger("TelemetrySelect").error("cannot replace " + path + ": " + str(err))
+		return false
+	Log.get_logger("TelemetrySelect").info("Telemetry " + ("allowed" if on else "declined"))
+	return true
