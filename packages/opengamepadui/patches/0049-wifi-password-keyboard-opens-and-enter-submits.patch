From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: retroforge <retroforge@invalid>
Date: Mon, 9 Nov 2026 23:30:00 +0000
Subject: [PATCH] fix(NetworkSelect, NetworkSettingsMenu): the Wi-Fi password
 dialog opens the keyboard, and Enter submits

Choosing a network with a password, on the first-boot network screen or
in Settings > Network, showed the password dialog with the field focused
but no on-screen keyboard: it only opened on A on the field. The keyboard
now opens with the dialog, after the field has taken the focus (on first
boot, once the dialog has faded in), as A on the field would open it. Not
for the open network in use, which has nothing to type.

On first boot, Enter on the keyboard only closed it and gave the focus
back to the field, whose focus neighbours were never set, so Godot
picked the nearest control on screen and the network list behind the
dialog could take it. Enter now submits the password, as Submit does,
and the field's D-pad neighbours stay inside the dialog (Settings >
Network got the same in 0018).

After a submit on first boot, by Enter or Submit, the focus goes to Next
instead of back to the network list: the network is chosen, and Next is
the step that follows.

Settings > Network's Enter already submitted, but synchronously, before
the keyboard closed and queued its refocus of the field: that refocus
came after the submit's refocus of the network list, which could leave
the focus on the hidden field. Both submit deferred now, after it.

On first boot, Submit tapped with the keyboard still up left the keyboard
open over the network list, typing into the hidden field: it closes now.

---
diff --git a/core/ui/card_ui/ootbe/network_select.gd b/core/ui/card_ui/ootbe/network_select.gd
index 98cacfc..aeee1a8 100644
--- a/core/ui/card_ui/ootbe/network_select.gd
+++ b/core/ui/card_ui/ootbe/network_select.gd
@@ -12,6 +12,8 @@ var logger := Log.get_logger("NetworkSelect")
 ## Submit handler of the password popup: one at a time (see network_settings_menu.gd).
 var _pending_submit: Callable
 var _show_password: Toggle
+## The dialog opened for a password opens the on-screen keyboard once it has faded in.
+var _keyboard_on_show := false
 
 @onready var next_button := $%NextButton as CardButton
 @onready var wifi_tree := $%WifiNetworkTree as WifiNetworkTree
@@ -32,6 +34,25 @@ func _ready() -> void:
 	box.move_child(_show_password, wifi_pass_box.get_index() + 1)
 	_show_password.toggled.connect(func(on: bool): wifi_pass_box.secret = not on)
 
+	# The D-pad stays in the dialog: the field's neighbors were unset, so Godot picked the nearest
+	# control on screen, and the network list behind the dialog could take the focus.
+	var line_edit := wifi_pass_box.line_edit as LineEdit
+	line_edit.focus_neighbor_top = line_edit.get_path_to(wifi_pass_button)
+	line_edit.focus_neighbor_bottom = line_edit.get_path_to(_show_password)
+	line_edit.focus_neighbor_left = line_edit.get_path_to(line_edit)
+	line_edit.focus_neighbor_right = line_edit.get_path_to(line_edit)
+
+	# The keyboard opens with the dialog (it only opened on A on the field), once the dialog has
+	# faded in and taken the focus (FocusOnPopupOpen, on the same signal).
+	var popup_fade := $PopupContainer/StateWatcher/FadeEffect as Effect
+	popup_fade.effect_finished.connect(_on_popup_shown)
+
+	# Enter on the keyboard only closed it and gave the focus back to the field, from where the
+	# network list could take it: it submits the password now, as Submit does.
+	var context := wifi_pass_box.keyboard_context as KeyboardContext
+	context.close_on_submit = true
+	context.submitted.connect(func(): _submit_from_keyboard.call_deferred())
+
 
 func _on_next_button() -> void:
 	# Determine the next state to go to
@@ -54,6 +75,8 @@ func _on_challenge_required(callback: Callable) -> void:
 	wifi_pass_box.text = ""
 	wifi_pass_box.secret = true
 	_show_password.button_pressed = false
+	# The open network in use has nothing to type.
+	_keyboard_on_show = not wifi_tree.challenge_open
 
 	# Show the password popup prompt and focus it
 	network_state_machine.set_state([password_popup_state])
@@ -66,5 +89,45 @@ func _on_challenge_required(callback: Callable) -> void:
 		# Execute the challenge callback with the entered password.
 		var password := wifi_pass_box.text as String
 		wifi_pass_box.text = ""
+		# Submit tapped with the keyboard still up: it stayed open over the network list, typing
+		# into the hidden field. Deferred, after FocusOnPopupClose's refocus of the list.
+		_close_keyboard.call_deferred()
+		# Next takes the focus, not the network list (FocusOnPopupClose): the network is chosen.
+		# Deferred, after that refocus and the keyboard's of the field.
+		next_button.grab_focus.call_deferred()
 		callback.call(password)
 	wifi_pass_button.button_up.connect(_pending_submit, CONNECT_ONE_SHOT)
+
+
+func _on_popup_shown() -> void:
+	if not _keyboard_on_show:
+		return
+	_keyboard_on_show = false
+	# Deferred: FocusOnPopupOpen focuses the field deferred, and the keyboard takes the focus from it
+	# as A on the field would.
+	_open_keyboard.call_deferred()
+
+
+## Opens the on-screen keyboard on the password field, if the dialog is still up.
+func _open_keyboard() -> void:
+	if not wifi_pass_box.is_visible_in_tree():
+		return
+	wifi_pass_box.keyboard.open(wifi_pass_box.keyboard_context)
+
+
+## Enter on the keyboard submits as Submit does (its handler and the StateUpdater that closes the
+## dialog). Deferred: the keyboard closes after its submitted handlers and queues a refocus of the
+## field, which has to come before the submit moves the focus to Next.
+func _submit_from_keyboard() -> void:
+	if not wifi_pass_button.is_visible_in_tree():
+		return
+	wifi_pass_button.button_up.emit()
+
+
+## Closes the on-screen keyboard if it still types into the (now hidden) password field, and gives
+## the focus to Next, which the keyboard's close had moved to the field.
+func _close_keyboard() -> void:
+	if wifi_pass_box.keyboard.context != wifi_pass_box.keyboard_context:
+		return
+	wifi_pass_box.keyboard.close()
+	next_button.grab_focus.call_deferred()
diff --git a/core/ui/common/settings/network_settings_menu.gd b/core/ui/common/settings/network_settings_menu.gd
index 923dd7c..f786824 100644
--- a/core/ui/common/settings/network_settings_menu.gd
+++ b/core/ui/common/settings/network_settings_menu.gd
@@ -62,9 +62,13 @@ func _ready() -> void:
 
 	# Configure the OSK with the password input box
 	var password_context := password_input.keyboard_context as KeyboardContext
+	# Deferred: the keyboard closes after its submitted handlers and queues a refocus of the field;
+	# the submit's own refocus of the network list has to come after it, or the focus was left on
+	# the hidden field.
 	var on_submit := func():
-		password_button.pressed.emit()
-	password_context.submitted.connect(on_submit)
+		if password_popup.visible and password_button.visible:
+			password_button.pressed.emit()
+	password_context.submitted.connect(func(): on_submit.call_deferred())
 	password_context.close_on_submit = true
 
 	# The dots hid a mistyped password with no way to check it: a toggle shows what was typed.
@@ -152,6 +156,10 @@ func _on_wifi_challenge(callback: Callable) -> void:
 	if back_watcher:
 		back_watcher.set_process_input(false)
 	(_forget_button if open else password_input).grab_focus.call_deferred()
+	# A password to type opens the keyboard with the dialog: it only opened on A on the field.
+	# Deferred after the field's focus, as A on the field would open it.
+	if not open:
+		_open_keyboard.call_deferred()
 
 	_pending_submit = func():
 		connecting = true
@@ -193,6 +201,13 @@ func _close_dialog() -> void:
 		back_watcher.set_process_input(is_visible_in_tree())
 
 
+## Opens the on-screen keyboard on the password field, if its dialog is still up.
+func _open_keyboard() -> void:
+	if not password_popup.visible or not password_input.line_edit.visible:
+		return
+	password_input.keyboard.open(password_input.keyboard_context)
+
+
 ## Closes the on-screen keyboard if it still types into the (now hidden) password field. Deferred
 ## after a submit: a submit from the keyboard's Enter closes it itself once its handlers return.
 func _close_keyboard() -> void:
