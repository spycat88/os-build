From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: retroforge <retroforge@invalid>
Date: Wed, 11 Nov 2026 23:30:00 +0000
Subject: [PATCH] fix(Settings): the settings lists scroll to the focused row

With a larger UI scale, the Settings category list on the left no longer
fits the screen, and moving down it with the D-pad took the focus below
the visible part without scrolling: the scroll bar had to be dragged by
hand. Its ScrollContainer, and the game settings' one built the same
way, did not set follow_focus, which the General, Library and Plugins
pages already do.

follow_focus is set now on the category lists of Settings and of a
game's settings, and on the Display, Network, Bluetooth and Disks pages,
which grow past the screen the same way at a larger scale.

---
 core/ui/card_ui/launch/game_settings.tscn             | 1 +
 core/ui/card_ui/settings/bluetooth_settings_menu.tscn | 1 +
 core/ui/card_ui/settings/disks_settings_menu.tscn     | 1 +
 core/ui/card_ui/settings/settings_menu.tscn           | 1 +
 core/ui/common/settings/display_settings_menu.tscn    | 1 +
 core/ui/common/settings/network_settings_menu.tscn    | 1 +
 6 files changed, 6 insertions(+)

diff --git a/core/ui/card_ui/launch/game_settings.tscn b/core/ui/card_ui/launch/game_settings.tscn
index 38d9e43..b74faa1 100644
--- a/core/ui/card_ui/launch/game_settings.tscn
+++ b/core/ui/card_ui/launch/game_settings.tscn
@@ -112,6 +112,7 @@ theme_override_constants/margin_bottom = 20
 
 [node name="ScrollContainer" type="ScrollContainer" parent="MarginContainer/HBoxContainer/MenuContainer/VBoxContainer/ButtonContainer/MarginContainer"]
 layout_mode = 2
+follow_focus = true
 
 [node name="MarginContainer" type="MarginContainer" parent="MarginContainer/HBoxContainer/MenuContainer/VBoxContainer/ButtonContainer/MarginContainer/ScrollContainer"]
 layout_mode = 2
diff --git a/core/ui/card_ui/settings/bluetooth_settings_menu.tscn b/core/ui/card_ui/settings/bluetooth_settings_menu.tscn
index 8edb753..0ddbab5 100644
--- a/core/ui/card_ui/settings/bluetooth_settings_menu.tscn
+++ b/core/ui/card_ui/settings/bluetooth_settings_menu.tscn
@@ -56,6 +56,7 @@ theme_override_constants/margin_bottom = 10
 
 [node name="ScrollContainer" type="ScrollContainer" parent="MarginContainer" unique_id=712808305]
 layout_mode = 2
+follow_focus = true
 
 [node name="UnavailableContainer" type="MarginContainer" parent="MarginContainer/ScrollContainer" unique_id=859986640]
 unique_name_in_owner = true
diff --git a/core/ui/card_ui/settings/disks_settings_menu.tscn b/core/ui/card_ui/settings/disks_settings_menu.tscn
index c5b2da1..ee78e6d 100644
--- a/core/ui/card_ui/settings/disks_settings_menu.tscn
+++ b/core/ui/card_ui/settings/disks_settings_menu.tscn
@@ -19,6 +19,7 @@ anchor_right = 1.0
 anchor_bottom = 1.0
 grow_horizontal = 2
 grow_vertical = 2
+follow_focus = true
 script = ExtResource("1_ct0k3")
 
 [node name="DiskManager" type="Node" parent="."]
diff --git a/core/ui/card_ui/settings/settings_menu.tscn b/core/ui/card_ui/settings/settings_menu.tscn
index 94976a6..d5f9c4f 100644
--- a/core/ui/card_ui/settings/settings_menu.tscn
+++ b/core/ui/card_ui/settings/settings_menu.tscn
@@ -182,6 +182,7 @@ theme_override_constants/margin_bottom = 20
 
 [node name="ScrollContainer" type="ScrollContainer" parent="MarginContainer/HBoxContainer/MenuContainer/VBoxContainer/ButtonContainer/MarginContainer"]
 layout_mode = 2
+follow_focus = true
 
 [node name="MarginContainer" type="MarginContainer" parent="MarginContainer/HBoxContainer/MenuContainer/VBoxContainer/ButtonContainer/MarginContainer/ScrollContainer"]
 layout_mode = 2
diff --git a/core/ui/common/settings/display_settings_menu.tscn b/core/ui/common/settings/display_settings_menu.tscn
index 100a73b..f8ff9da 100644
--- a/core/ui/common/settings/display_settings_menu.tscn
+++ b/core/ui/common/settings/display_settings_menu.tscn
@@ -21,6 +21,7 @@ grow_horizontal = 2
 grow_vertical = 2
 size_flags_horizontal = 3
 size_flags_vertical = 3
+follow_focus = true
 script = ExtResource("1_w4xaq")
 
 [node name="InputWatcher" parent="." instance=ExtResource("2_jrm6t")]
diff --git a/core/ui/common/settings/network_settings_menu.tscn b/core/ui/common/settings/network_settings_menu.tscn
index f3a8e58..52f5ac5 100644
--- a/core/ui/common/settings/network_settings_menu.tscn
+++ b/core/ui/common/settings/network_settings_menu.tscn
@@ -25,6 +25,7 @@ grow_horizontal = 2
 grow_vertical = 2
 size_flags_horizontal = 3
 size_flags_vertical = 3
+follow_focus = true
 script = ExtResource("1_2qdps")
 
 [node name="InputWatcher" parent="." unique_id=985727808 instance=ExtResource("2_yj01k")]
