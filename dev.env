# retroforge dev-build environment — TRACKED, and deliberately free of secrets.
#
# Usage, from the repo root, before ANY make target (`set -a` is what exports these into make,
# which forwards them into the container via DEV_ENV):
#
#     set -a; . ./dev.env; set +a
#     make sdcard
#
# Chain it into EVERY invocation, not just the first. RETROFORGE_DEV changes the image CONTENT, so a
# bare `make verify-image` or `make bundle` afterwards flips the mode stamp and rebuilds RELEASE
# over your dev image.
export RETROFORGE_DEV=1

# --- SSH: a throwaway key per checkout, NOT your personal one --------------------------------
# Generated here rather than read from ~/.ssh on purpose. A dev image is disposable and gets handed
# around; putting your daily-driver identity in its authorized_keys means the private key you use
# for everything else is what unlocks it. This key exists only to reach dev images, so it can be
# deleted or rotated at will (rm -rf work/dev-ssh) and losing a card implicates nothing else.
#
# It lives under work/ (gitignored) and SURVIVES `make distclean` — that target only removes
# work/kernel and work/base — so the identity is stable across rebuilds and your
# known_hosts entry keeps working.
#
# Set RETROFORGE_SSH_PUBKEY yourself to override (e.g. a hardware token, or a shared lab key).
if [ -z "${RETROFORGE_SSH_PUBKEY:-}" ]; then
  if [ ! -f work/dev-ssh/id_ed25519.pub ]; then
    mkdir -p work/dev-ssh
    ssh-keygen -t ed25519 -N '' -C "retroforge-dev@$(hostname -s 2>/dev/null || echo local)" \
               -f work/dev-ssh/id_ed25519 >/dev/null
    echo "dev.env: generated throwaway dev-image SSH key at work/dev-ssh/id_ed25519" >&2
    echo "dev.env: connect with  ssh -i work/dev-ssh/id_ed25519 root@<device>" >&2
  fi
  export RETROFORGE_SSH_PUBKEY="$(cat work/dev-ssh/id_ed25519.pub)"
fi
# --- OTA: a dev signing key per checkout, so a dev image updates instead of being reflashed ------
# A dev image trusts this build box's own dev CA beside the project's (rootfs/lib-assemble-devimage.sh
# adds work/dev-pki/ca.cert.pem to its keyring), and `make bundle` here signs with its key. Flash an
# image once; after that every build installs over it and its /home survives:
#     make bundle && scp out/images/retroforge-*.raucb root@<device>:/home/ && ssh root@<device> rauc install /home/<bundle>
# Kept under work/ like the SSH key; never regenerated over itself (see ota/gen-dev-signing.sh).
ota/gen-dev-signing.sh

# --- optional: Wi-Fi credentials -------------------------------------------------------------
# A dev image with no Wi-Fi profile cannot be reached over SSH, and this device has no UART, so its
# only debug path is the offline card-mount (`journalctl -D`). That is a legitimate mode — it is
# what the shipping first boot looks like, which is how you test OOBE — but it is not what you
# want most days.
#
# For an image that auto-joins your LAN, create dev.env.local (gitignored) with YOUR values:
#
#     export RETROFORGE_WIFI_SSID="my-ssid"
#     export RETROFORGE_WIFI_PSK="my-psk"
#
# NEVER put them in THIS file: it is tracked, so a PSK here lands in the history, and the
# --skip-worktree trick meant to hide local edits is undone by a stash, a rebase, or a fresh
# clone. One tracked file without secrets plus one ignored file with them is why there are two.
# RetroForge's ScreenScraper developer login goes there too, for ROM art scraping (every build,
# not only dev ones; CI reads repository secrets of the same names):
#     export RETROFORGE_SS_DEVID="..."
#     export RETROFORGE_SS_DEVPASSWORD="..."
[ -f ./dev.env.local ] && . ./dev.env.local

# RETROFORGE_WIFI is the INTENT knob, needed only to resolve the ambiguous cases:
#
#   unset + creds present  ->  profile baked in (the normal dev loop)
#   unset + no creds       ->  no profile, loud warning (a fresh clone just works)
#   RETROFORGE_WIFI=1        ->  profile REQUIRED; missing creds is a hard error instead of a
#                              silently unreachable image (use in anything that relies on SSH)
#   RETROFORGE_WIFI=0        ->  no profile even when creds are present, so you can test the
#                              no-network first boot without editing dev.env.local
#
# The build stamps which of these it actually produced (ROOTFS_MODE in the Makefile), so flipping
# between them re-assembles the rootfs instead of handing back the previous image.
export RETROFORGE_WIFI="${RETROFORGE_WIFI-}"
