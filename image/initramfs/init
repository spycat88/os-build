#!/bin/sh
# retroforge initramfs init — Phase 5: mount the booted slot's root (ro) + var, stack the /etc
# overlay, then hand off to systemd.
#
# WHAT PICKED THE SLOT IS NOT HERE. OpenABL picks the slot's Boot Loader Specification entry on
# its boot partition (by RAUC's state: loader.conf's default and the entries' boot counters) and boots
# the kernel with that entry's full cmdline. This init merely carries out what the cmdline says:
#
#   root=PARTUUID=...                   the slot's btrfs root, mounted ro
#   retroforge.var=PARTUUID=...           the slot's ext4 /var (overlay upper + per-slot identity)
#   retroforge.slot=A|B                   which slot the above two are
#
#                                       The first two are PARTUUID because every retroforge medium
#                                       carries the same eight PARTLABELs, so with a card inserted
#                                       on a device installed to internal storage a PARTLABEL
#                                       resolves to whichever disk enumerates first. The entry's
#                                       writer read the UUIDs off the disk it wrote the entry to;
#                                       PARTLABEL= is still accepted here.
#
# The old design-C machinery — the /RETROFORGE/STATE.* read/write, slot selection, failover,
# kernel-mismatch warning and KERNEL.BAK rollback — is gone. OpenABL's boot counting owns "did a
# slot come up", and the OS owns "is this slot OK" via retroforge-boot-good.service (RAUC's
# mark-good / mark-bad). Nothing here chooses anything.
#
# WHY THE /ETC OVERLAY IS IN THE INITRAMFS AT ALL: it cannot be assembled after PID1 starts.
# systemd reads /etc/fstab (via generators), /etc/machine-id, /etc/hostname and system.conf
# before any unit can run, so an overlay mounted by a unit would leave every one of those reading
# the read-only lower dir forever. The machine-id case is the sharpest: a read-only /etc makes
# systemd fall back to a transient /run/machine-id, which makes EVERY boot look like a first boot
# (re-running preset-all). So the overlay has to be in place before we exec systemd.
#
# We need no modules: btrfs, ext4, vfat and overlayfs are all =y in kernel.config, and every
# block/storage driver is builtin too. So this is a plain shell script over a handful of
# util-linux binaries, staged by image/mkinitramfs.sh. No udev, no modprobe, no systemd-in-initrd.
#
# Layout (image/partition-table.txt):
#   root  <- PARTUUID=... (root=)             btrfs, ro
#   var   <- PARTUUID=... (retroforge.var=)     ext4, rw   (overlay upper+work; /lib/retroforge/slot)
#   /etc  <- overlay(lower=/sysroot/etc, upper=/sysroot/var/lib/overlays/etc/upper)
#
# Neither the shared ESP nor the slots' boot partitions are mounted here: the booted system mounts
# them from /etc/fstab (/esp, and /run/retroforge/bootfs/{a,b} on demand), and GPT bit 63
# (partition-table.txt) keeps gpt-auto away from the ESP.
#
# DEGRADED BOOT: this device has no serial console ([[sm8650-no-uart]]), so a hard failure here
# is only debuggable by pulling the card and mounting it. Every step past "root is mounted"
# therefore falls back rather than dying: we log the reason to /dev/kmsg (which lands in the
# journal, readable offline via `journalctl -D`) and boot with a writable root and no overlay —
# which is exactly the configuration that shipped before this change, so the fallback is
# known-good rather than novel. The failure is loud, not silent.
#
# A root that will not mount is different: with no root there is no system, so that is a panic
# (panic=5 on the entry's cmdline reboots). Failover to the other slot is NOT done here — that
# is the bootloader's job, and doing it here too would fight the boot-attempts counter's accounting.
set -u

SYSROOT=/sysroot

log()  { printf '<6>retroforge-init: %s\n' "$*" >/dev/kmsg 2>/dev/null || :; }
warn() { printf '<3>retroforge-init: %s\n' "$*" >/dev/kmsg 2>/dev/null || :; }

# Everything under here is pre-created in the cpio, so no mkdir is needed before /dev exists.
mount -t proc     -o nosuid,noexec,nodev proc /proc
mount -t sysfs    -o nosuid,noexec,nodev sys  /sys
mount -t devtmpfs -o nosuid,mode=0755    dev  /dev
# /run is mounted here because util-linux switch_root walks {/dev,/proc,/sys,/run} and moves each
# into $SYSROOT; when /run is not a mountpoint that move fails and prints a "failed to mount
# moving /run to /sysroot/run" warning to the console. The boot recovers (systemd mounts its own
# /run post-pivot), so this is cosmetic — but on a no-UART device ([[sm8650-no-uart]]) a spurious
# boot-console error is a debugging trap, so we give switch_root a real tmpfs to hand over.
mount -t tmpfs    -o nosuid,nodev,mode=0755 run /run

ROOTSPEC=''; VARSPEC=''; SLOTSPEC=''; ROOTFSTYPE=btrfs; SPLASH=1
read -r _cmdline </proc/cmdline
for _arg in $_cmdline; do
  case "$_arg" in
    root=*)          ROOTSPEC=${_arg#root=} ;;
    rootfstype=*)    ROOTFSTYPE=${_arg#rootfstype=} ;;
    retroforge.var=*)  VARSPEC=${_arg#retroforge.var=} ;;
    retroforge.slot=*) SLOTSPEC=${_arg#retroforge.slot=} ;;
    retroforge.splash=*) SPLASH=${_arg#retroforge.splash=} ;;
  esac
done

# ---------------------------------------------------------------------------------------------
# Boot splash
# ---------------------------------------------------------------------------------------------
# Started HERE, before root is even resolved, because everything after this point can take
# seconds (a device probe poll, a btrfs mount) and all of it is a black panel otherwise.
#
# The drawer keeps running across switch_root. There is no systemd in this initramfs to kill it
# and no unit to exempt: it is simply a background process whose binary and libraries the kernel
# frees when the initramfs is dropped, which is harmless because it is statically linked and has
# already read everything it needs into memory (see apps/retroforge-splash/src/retroforge-splash.c).
# Its status and takeover files live on /run, which switch_root moves into the new root, so both
# paths stay valid on the far side of the pivot.
#
# `retroforge.splash=0` on the cmdline turns it off. That switch is on the CMDLINE and not in /etc
# on purpose: /etc does not exist yet at this point in boot, and on a board with no serial
# console the ability to take the splash out of the picture is sometimes the only way to see a
# kernel message that it would otherwise be covering.
splash_start() {
  [ "$SPLASH" = 0 ] && { log "splash disabled on the cmdline"; return; }
  [ -x /usr/lib/retroforge/retroforge-splash ] || { warn "splash binary missing from the initramfs"; return; }

  # The DPU binds asynchronously, so /dev/dri/card0 does not exist for the first ~3s of boot and
  # the drawer would find no device at all. Poll rather than sleep a fixed amount: the wait is
  # usually much shorter than the ceiling, and every 100ms spent here is 100ms of black panel.
  _i=0
  while [ "$_i" -lt 50 ]; do
    [ -e /dev/dri/card0 ] && break
    sleep 0.1; _i=$((_i + 1))
  done
  # No card is not fatal — the drawer falls back to /dev/fb0 by itself, and a board where
  # neither exists still boots, just without a splash.
  [ -e /dev/dri/card0 ] || warn "no /dev/dri/card0 after 5s; the splash will try fbdev"

  mkdir -p /run/retroforge/splash
  printf 'Starting RetroForge\n' >/run/retroforge/splash/status

  # Rotation is deliberately NOT passed: the drawer reads the panel's own DRM `panel orientation`
  # property, which the kernel derives from the panel's devicetree `rotation`. That keeps the
  # fact in one place instead of duplicating it into a per-board config the initramfs would then
  # have to carry.
  #
  # stderr goes to kmsg so that a splash that fails to start says why in the journal, readable
  # offline from the card ([[sm8650-no-uart]]). Without this the failure is a black screen and
  # nothing else.
  /usr/lib/retroforge/retroforge-splash \
      --image /usr/share/retroforge/splash/logo.nds1 \
      --font /usr/share/retroforge/splash/font.ttf \
      --status /run/retroforge/splash/status \
      --takeover /run/retroforge/splash/takeover \
      --ready /run/retroforge/splash/ready \
      >/dev/kmsg 2>&1 &
  SPLASH_PID=$!
}
splash_start
# Resolve a root=-style spec (PARTLABEL=/LABEL=/UUID=/PARTUUID=/bare path) to a block device,
# polling for it. There is no udev here and storage probes asynchronously, so the device may
# simply not exist yet on the first pass — this is what the kernel's own `rootwait` does for us
# when it mounts root itself. ~30s, then give up.
#
# PARTUUID= is read from each disk's own partition table, one partx call per disk. findfs answers it
# too, but with no udev links and no cache it first probes every partition for a filesystem, ~100
# with the eMMC's vendor ones: the root mounted 0.58 s after the card's partitions appeared, and
# 0.16 s with this (Air X, 2026-10-31).
by_partuuid() {  # <uuid>: the partition device carrying it
  local want=${1,,} disk tok nr="" uuid p n
  for disk in /sys/block/*; do
    [ -e "$disk/device" ] || continue   # zram, loop: nothing to boot from
    for tok in $(partx -g -P -o NR,UUID "/dev/${disk##*/}" 2>/dev/null); do
      case $tok in
        NR=*)   nr=${tok#NR=}; nr=${nr//\"/} ;;
        UUID=*) uuid=${tok#UUID=}; uuid=${uuid//\"/}
                [ -n "$uuid" ] && [ "${uuid,,}" = "$want" ] || continue
                for p in "$disk"/*/partition; do
                  read -r n < "$p" 2>/dev/null && [ "$n" = "$nr" ] || continue
                  p=${p%/partition}; printf '/dev/%s' "${p##*/}"; return 0
                done ;;
      esac
    done
  done
  return 1
}

resolve() {
  _spec=$1 _i=0
  while [ "$_i" -lt 300 ]; do
    case "$_spec" in
      /dev/*) [ -b "$_spec" ] && { printf '%s' "$_spec"; return 0; } ;;
      PARTUUID=*)
        if command -v partx >/dev/null; then _d=$(by_partuuid "${_spec#PARTUUID=}")
        else _d=$(findfs "$_spec" 2>/dev/null); fi
        [ -n "$_d" ] && [ -b "$_d" ] && { printf '%s' "$_d"; return 0; } ;;
      *)      _d=$(findfs "$_spec" 2>/dev/null) && [ -b "$_d" ] && { printf '%s' "$_d"; return 0; } ;;
    esac
    sleep 0.1; _i=$((_i + 1))
  done
  return 1
}

# The slot letter for /run/retroforge/boot. The entry states it outright — it is written per slot, so
# it knows which one it is — and that is the only thing that can tell us: the root= spec is a
# PARTUUID, which carries no slot letter at all.
#
# The PARTLABEL match is kept for a hand-written command line that names the root by label. Without
# it such a boot reports slot='' and retroforge-bootctl mark-good treats a real slot boot as a dev
# boot.
#
# Empty on any other root (a dev boot) — which is exactly what mark-good needs to know.
SLOT=''
case "$SLOTSPEC" in
  A|B) SLOT=$SLOTSPEC ;;
esac
if [ -z "$SLOT" ]; then
  case "$ROOTSPEC" in
    PARTLABEL=retroforge-root-A) SLOT=A ;;
    PARTLABEL=retroforge-root-B) SLOT=B ;;
  esac
fi

# ---------------------------------------------------------------------------------------------
# Root
# ---------------------------------------------------------------------------------------------
[ -n "$ROOTSPEC" ] || { warn "no root= on the kernel cmdline — cannot continue"; exit 1; }
if ! ROOTDEV=$(resolve "$ROOTSPEC"); then
  warn "root device '$ROOTSPEC' never appeared after 30s — panicking (panic=5 reboots)"
  exit 1
fi
if ! mount -t "$ROOTFSTYPE" -o ro "$ROOTDEV" "$SYSROOT"; then
  warn "cannot mount root $ROOTDEV ($ROOTFSTYPE) — panicking (panic=5 reboots)"
  exit 1
fi
log "root $ROOTDEV mounted ro (slot=${SLOT:-?})"

# From here on, failures degrade instead of panicking (see the header).
degrade() {
  warn "DEGRADED: $1"
  warn "DEGRADED: booting with a writable root and no /etc overlay (pre-initramfs behaviour)"
  mount -o remount,rw "$SYSROOT" || warn "DEGRADED: remount,rw failed too — root stays read-only"
}

# ---------------------------------------------------------------------------------------------
# /var + the /etc overlay
# ---------------------------------------------------------------------------------------------
# Kept inline rather than in a function: a $(...) capture would run the mounts in a subshell
# and swallow the device names we want to log.
overlay_ok=0
if [ -z "$VARSPEC" ]; then
  degrade "no retroforge.var= on the kernel cmdline"
elif ! VARDEV=$(resolve "$VARSPEC"); then
  degrade "var device '$VARSPEC' never appeared after 30s"
elif ! mount -t ext4 "$VARDEV" "$SYSROOT/var"; then
  degrade "cannot mount var $VARDEV at $SYSROOT/var"
else
  # upper and work MUST share a filesystem (overlayfs rename requirement) — both live on /var.
  OVL=$SYSROOT/var/lib/overlays/etc
  # lowerdir is the /etc we just mounted read-only; overlayfs resolves it now, at mount time,
  # so mounting the result over that same path is safe.
  if mkdir -p "$OVL/upper" "$OVL/work" \
     && mount -t overlay etc \
          -o "lowerdir=$SYSROOT/etc,upperdir=$OVL/upper,workdir=$OVL/work" "$SYSROOT/etc"; then
    overlay_ok=1
    log "var $VARDEV mounted; /etc overlay stacked (upper=/var/lib/overlays/etc/upper)"
  else
    degrade "cannot stack the /etc overlay on $VARDEV"
  fi
fi

# Hand the decision to the running system. /run is moved into the new root by switch_root, so
# this survives the pivot. retroforge-bootctl mark-good reads slot= to tell "a slot boot" from a
# "dev/cmdline boot" (nothing to confirm), and the fields are the first evidence when debugging
# a boot offline.
mkdir -p /run/retroforge
{ printf 'slot=%s\n'   "${SLOT}"
  printf 'source=%s\n' 'bls'
  printf 'root=%s\n'   "${ROOTDEV:-}"
  printf 'var=%s\n'    "${VARDEV:-}"
} >/run/retroforge/boot 2>/dev/null || warn "cannot write /run/retroforge/boot"

[ "$overlay_ok" -eq 1 ] || warn "DEGRADED: handing off to systemd on a writable, un-overlaid root"

# The drawer reads its logo, its font and the run directory by path, so it must have them before
# switch_root empties this root. It usually does (the Air X: before root is even mounted), but where
# the root turns up at once the pivot came first: on the Pocket FIT Elite and the RP5 the drawer lost
# all three and kept DRM master from the session for good (2026-11-01). It creates the ready file
# once it has them.
if [ -n "${SPLASH_PID:-}" ]; then
  _i=0
  while [ ! -e /run/retroforge/splash/ready ] && kill -0 "$SPLASH_PID" 2>/dev/null && [ "$_i" -lt 200 ]; do
    sleep 0.01; _i=$((_i + 1))
  done
  [ -e /run/retroforge/splash/ready ] || warn "the splash did not get ready; switching root without it"
fi

# systemd holds back every mount unit while its mount-table watcher is rate limited, past 5 changes
# a second by default, and the boot's own mounts go past that: /tmp and /esp, then /home, which
# waited out the rest of the second (~0.95 s on the Air X, every boot, 2026-10-31), then its binds.
# The limit is settable only through PID1's environment, which this exec hands on.
export SYSTEMD_DEFAULT_MOUNT_RATE_LIMIT_BURST=50
exec switch_root "$SYSROOT" /usr/lib/systemd/systemd
