#!/usr/bin/env bash
# retroforge internal install — THE SPINE. Phase 4c of .claude/plans/internal-install.plan.md.
#
#   retroforge-install --bundle <url> [--disk <dev>] [--userdata-gib N]
#                    [--intent fresh|reinstall] [--erase-home]
#   retroforge-install --bundle running:<root-dev> ...
#
# THE SOURCE IS A BUNDLE, OR THE RUNNING ROOT. `running:<dev>` is what installer/release-info
# answers on a dev image: the root slot this card booted from is copied byte for byte into root-a
# instead of a bundle being streamed, and then the SAME handler a bundle install runs
# (post-install-fresh.sh) re-randomises its fsid and seeds var-a. A dev card's channel usually has
# nothing published, and what a person testing one wants on internal storage is the build in their
# hand. It is the running system, so there is no signature to check: it is exactly as trusted as
# the code doing the copying. verify_sources() checks instead that the device really is the
# mounted root and that it fits the slot.
#
# Installs RetroForge onto a device's INTERNAL storage, from a running card whose slots are not the
# ones being built, beside an Android that stays bootable. It is the ordered list of steps and
# nothing else: every step is a named function, each one delegates to a component that already has
# its own suite, and the ordering IS the contract.
#
# THE ORDER, and what each boundary buys:
#
#   recon              nothing has been read yet; the tools are checked here, together, so a missing
#                      mkfs.btrfs is found now and not after userdata is gone
#   select-target      pure, side-effect free, its own 83-case suite. Refuses the running disk, a
#                      damaged GPT, a foreign bootable ESP, two eligible disks
#   record             the pre-state, kept for the run's log. NOT A BACKUP -- see
#                      the block at write_install_record for why the installer deliberately keeps
#                      none, and why this can never refuse an install
#   verify sources     the bundle verifies against THIS device's keyring. Plan §3 rule 11: before
#                      the first sgdisk, because a bundle that will not verify must not cost the
#                      user their Android data
#   ------------------ everything above is reversible; nothing below is
#   CONFIRM            §4d. The last point at which the disk is untouched
#   carve              userdata shrinks, its stale superblock is invalidated, our eight are appended
#   mkfs               esp, efi-a, efi-b, home. NOT var-a (seed_var reformats it) and NOT var-b
#   rauc               root-a streamed and verified; the handler randomises its fsid and seeds var-a
#   /home              the empty player home, staged into the partition just created exactly as
#                      the card stages it
#   efi-a / efi-b      stage-2 grub.cfg, parts.env -- the map of THIS disk
#   ESP                grubenv with RAUC's slot state, parts.env, \dtbs\qcom, then the ESP GRUB
#   bootaa64.efi       THE LAST BYTE WRITTEN. See below
#
# WHY bootaa64.efi IS LAST, and it is a hardware finding rather than a convention. ABL's test is
# CONTENT-based: it chainloads /EFI/BOOT/bootaa64.efi from an internal ESP if that file exists, and
# measured on the Pocket ACE 2026-08-21 an internal ESP that exists but is EMPTY does not divert it
# at all -- the device came straight back to the card. So every interruption before that one copy
# leaves a device that still boots the card and can simply be re-run, and only after it
# does recovery need ABL's "force external". That is the difference between a recoverable device and
# one the user believes we bricked, and it is bought by ordering alone. refresh_esp_stage1() writes
# that file last for the same reason.
#
# WHAT THIS SCRIPT DOES NOT DO, deliberately:
#   - it does not join a network (§4b) and it does not resolve latest.json. It is handed URLs.
#   - it does not render the consent screen (§4d). It decides WHETHER consent was given; the screen
#     is a separate program behind $CONFIRM, so that the policy lives where the offline suite is and
#     the pixels live where the display is.
#   - it does not write `devinfo` to make internal the default boot target. Refused on purpose and
#     permanently: the format is ABL-private, and on Qualcomm parts devinfo also carries unlock and
#     verity state. The closing message tells the user to hold Volume Up instead.
#   - it never touches the SD card, and never touches a partition it did not create. The one
#     exception is userdata, which carve.sh recreates at a new size -- that is the whole consent.
set -euo pipefail

PROG=${0##*/}
log()  { printf '[%s] %s\n' "$PROG" "$1"; }
warn() { printf '[%s] WARNING: %s\n' "$PROG" "$1" >&2; }
die()  { printf '[%s] ERROR: %s\n' "$PROG" "$1" >&2; exit 1; }
step() { printf '\n[%s] == %s ==\n' "$PROG" "$1"; }

SELFDIR="$(cd "$(dirname "$0")" && pwd)"

# --- seams ---------------------------------------------------------------------------------------
# tests/test-install.sh executes THIS file, so what it asserts is the artifact that ships.
# Overriding these points it at a sandbox and at stub binaries. DEVTEST is the one assertion a
# sandbox cannot keep -- an unprivileged test has no block device to offer -- and it is the same
# pair rauc-session.sh and post-install.sh document: everything a wrong answer destroys lives behind
# a device argument, so treat RUNDIR and DEVTEST as related.
RUNDIR=${RETROFORGE_INSTALL_RUN:-/run/retroforge/install}
DEVTEST=${DEVTEST:--b}
# The other assertion a sandbox cannot keep: the suite is not root, and running it as root to reach
# these code paths would mean an offline test with the privileges to destroy the developer's disk.
REQUIRE_ROOT=${REQUIRE_ROOT:-1}
SGDISK=${SGDISK:-sgdisk}
SHA256=${SHA256:-sha256sum}
KEYRING=${KEYRING:-/etc/rauc/keyring.pem}

# The session user. The card's OS has one and a recovery medium would not: `player` is in `input`, so
# it can open /dev/uinput, InputPlumber's bus takes calls from anyone, and the sequence is on
# confirm-ui's command line. A process of its alive at consent could read the sequence and press it.
# retroforge-installer.service ends the user first; assert_no_session_user() refuses if that failed.
PGREP=${PGREP:-pgrep}
SESSION_UID=${PLAYER_UID:-1000}
SESSION_WAIT=${RETROFORGE_SESSION_WAIT:-5}
# The board the running card booted with, read to save the first internal boot from the board menu.
CARD_GRUBENV=${RETROFORGE_CARD_GRUBENV:-/esp/EFI/steamos/grubenv}

# The consent program. A FIXED PATH with a seam that names WHO renders the screen -- never a value
# that means "consent given". There is deliberately no variable, flag or file that
# satisfies the gate: see take_consent() for the contract, which any substitute still has to
# implement. An installer that cannot take consent cannot install.
CONFIRM=${RETROFORGE_CONFIRM:-/usr/lib/retroforge/install/confirm}

# The components. Resolved by search rather than by repo-relative paths, exactly as carve.sh
# resolves genpart.sh: some of these ship into the rootfs (/usr/lib/retroforge/install/) and some are
# staged from installer/, so on the device they sit together and in the repo they do not.
find_component() {  # <name> <repo-subdir>
  local name="$1" sub="$2" c
  for c in "$SELFDIR/$name" "/usr/lib/retroforge/install/$name" "$SELFDIR/../$sub/$name"; do
    [ -e "$c" ] && { printf '%s\n' "$c"; return 0; }
  done
  return 1
}
SELECT=${RETROFORGE_SELECT_TARGET:-$(find_component select-target.sh install || true)}
CARVE=${RETROFORGE_CARVE:-$(find_component carve.sh install || true)}
SESSION=${RETROFORGE_RAUC_SESSION:-$(find_component rauc-session.sh install || true)}
HOMESTAGE=${RETROFORGE_HOMESTAGE:-$(find_component lib-homestage.sh images || true)}
SLOTWRITE=${RETROFORGE_SLOTWRITE:-$(find_component lib-slotwrite.sh \
            rootfs/overlay/usr/lib/retroforge/install || true)}
# The running-root source only: the handler rauc-session.sh names for a bundle, run here directly,
# and the table the slot size comes from.
POST_INSTALL=${POST_INSTALL:-$(find_component post-install-fresh.sh install || true)}
PARTTABLE=${RETROFORGE_PARTITION_TABLE:-$(find_component partition-table.txt image || true)}
# Where the running root is mounted, and the mount table that says from what. Seams for the suite.
RUNNING_MNT=${RETROFORGE_RUNNING_MNT:-/}
MOUNTINFO=${RETROFORGE_MOUNTINFO:-/proc/self/mountinfo}
# The Wi-Fi networks this card knows, carried to the install (carry_wifi). The merged /etc view, so
# a network joined in Settings (the /etc overlay upper) and one baked into a dev card both count.
NM_CONNECTIONS=${RETROFORGE_NM_CONNECTIONS:-/etc/NetworkManager/system-connections}

# --- arguments -----------------------------------------------------------------------------------
usage() {
  printf 'usage: %s --bundle <url> [options]\n' "$PROG" >&2
  printf '  --disk <dev>          target disk; omitted, exactly one must pass selection\n' >&2
  printf '  --userdata-gib <n>    size Android'"'"'s data partition is recreated at (fresh only)\n' >&2
  printf '  --intent fresh|reinstall   what the USER asked for; never inferred from the disk\n' >&2
  printf '  --erase-home          reinstall only: recreate /home instead of keeping it\n' >&2
  exit 2
}

DISK=""; UD_GIB=""; BUNDLE=""; INTENT=""; ERASE_HOME=0
while [ $# -gt 0 ]; do
  case "$1" in
    --disk)         DISK="${2:-}"; shift 2 ;;
    --userdata-gib) UD_GIB="${2:-}"; shift 2 ;;
    --bundle)       BUNDLE="${2:-}"; shift 2 ;;
    --intent)       INTENT="${2:-}"; shift 2 ;;
    --erase-home)   ERASE_HOME=1; shift ;;
    -h|--help)      usage ;;
    *)              printf '%s: unknown argument %s\n' "$PROG" "$1" >&2; usage ;;
  esac
done
[ -n "$BUNDLE" ] || die "no --bundle given"

# running:<dev> -- copy the root this system booted from (see the header). SOURCE_ROOT is set only
# for that source; every bundle-only step tests it.
SOURCE_ROOT=""
case "$BUNDLE" in
  running:*)
    SOURCE_ROOT="${BUNDLE#running:}"
    [ -n "$SOURCE_ROOT" ] || die "--bundle running: names no device"
    ;;
esac

# THE INTENT IS THE USER'S AND IT IS AN ARGUMENT, never read off the disk -- carve.sh's header makes
# the same point and it is the same reason: the disk only distinguishes "ours" from "not ours", and
# a script that inferred intent from that would have to guess between reinstalling, resizing
# Android's share, and removing us. Two of those three guesses erase something the user wanted kept.
# The default is `fresh` only because a disk with no retroforge on it admits nothing else, and
# recon() below refuses the combination that would make the default wrong.
case "${INTENT:-}" in
  ''|fresh|reinstall) ;;
  *) die "--intent must be fresh or reinstall, got '$INTENT'" ;;
esac

# --- state carried between steps -----------------------------------------------------------------
MODE=""; SECTOR=""; UD_INDEX=""; UD_START=""; UD_END=""; CEIL=""; WWID=""
declare -A PART=()          # gpt name -> index, from carve.sh
declare -A DEV=()           # gpt name -> /dev/disk/by-partuuid/...
MOUNTS=()                   # unwound by the EXIT trap, deepest first

# ONE EXIT TRAP FOR THE WHOLE RUN, armed before the first mount. seed_var() in lib-slotwrite.sh
# chains onto whatever handler it finds and restores it afterwards precisely so this one survives
# the RAUC handler running underneath it; that arrangement only works if this is armed first.
cleanup() {
  local st=$? i
  for (( i=${#MOUNTS[@]}-1; i>=0; i-- )); do
    umount "${MOUNTS[$i]}" 2>/dev/null || true
  done
  return $st
}
trap cleanup EXIT

mount_at() {  # <dev> <mountpoint> [options...]
  local dev="$1" mnt="$2"; shift 2
  mkdir -p "$mnt" || die "cannot create $mnt"
  mount "$@" "$dev" "$mnt" || die "cannot mount $dev at $mnt"
  MOUNTS+=("$mnt")
}

unmount_at() {  # <mountpoint> -- drop it from the trap's list too, so a later failure does not retry
  local mnt="$1" i keep=()
  umount "$mnt" || die "cannot unmount $mnt"
  for i in "${MOUNTS[@]}"; do [ "$i" = "$mnt" ] || keep+=("$i"); done
  MOUNTS=("${keep[@]+"${keep[@]}"}")
}

# =================================================================================================
# 1. recon
# =================================================================================================
# EVERY EXTERNAL COMMAND, ASSERTED TOGETHER AND FIRST. rootfs/guard-rootfs.sh checks a release root
# against the same tools, but a dev root skips the guard -- and an offline suite inherits the HOST's PATH, so it proves the logic and never the image's tool
# inventory. The cost of finding out late is the point: mkfs.btrfs is not called until after
# userdata has been destroyed, and a spine that discovered it there would have taken the user's
# Android data to reach an error it could have printed at second zero.
recon() {
  step "recon"
  [ "$REQUIRE_ROOT" = 0 ] || [ "$(id -u)" = 0 ] || die "must run as root"

  local t missing=""
  for t in "$SGDISK" "$SHA256" \
           mkfs.vfat mkfs.ext4 mkfs.btrfs btrfstune btrfs blkid \
           mount umount tar rauc dbus-daemon gdbus partprobe udevadm pgrep; do
    command -v "$t" >/dev/null 2>&1 || missing="$missing $t"
  done
  [ -z "$missing" ] && log "tools: all present" \
    || die "this image is missing:$missing"

  local c
  for c in "$SELECT" "$CARVE" "$SESSION"; do
    [ -n "$c" ] && [ -x "$c" ] || die "cannot find an executable component (looked for select-target.sh, carve.sh, rauc-session.sh)"
  done
  if [ -n "$SOURCE_ROOT" ]; then
    command -v dd >/dev/null 2>&1 || die "this image is missing: dd"
    [ -n "$POST_INSTALL" ] && [ -x "$POST_INSTALL" ] \
      || die "cannot find post-install-fresh.sh -- the copied root would keep the card's fsid and get no /var"
    [ -n "$PARTTABLE" ] && [ -r "$PARTTABLE" ] || die "cannot find partition-table.txt -- the root slot's size is unknown"
  fi
  for c in "$SLOTWRITE" "$HOMESTAGE"; do
    [ -n "$c" ] && [ -r "$c" ] || die "cannot find lib-slotwrite.sh / lib-homestage.sh"
  done
  [ -r "$KEYRING" ] || die "no readable RAUC keyring at $KEYRING -- nothing would be verified"
  [ -x "$CONFIRM" ] || die "no consent program at $CONFIRM -- an installer that cannot take consent cannot install"

  # 0700: rauc-session.sh's private bus and the consent facts live under it.
  mkdir -p "$RUNDIR" && chmod 0700 "$RUNDIR" || die "cannot create $RUNDIR"

  # shellcheck source=../rootfs/overlay/usr/lib/retroforge/install/lib-slotwrite.sh
  . "$SLOTWRITE"
  # shellcheck source=../image/lib-homestage.sh
  . "$HOMESTAGE"
}

# =================================================================================================
# 2. select-target
# =================================================================================================
# Delegated entirely. select-target.sh is pure and has its own suite; every refusal in it -- the
# running disk, a damaged GPT, a foreign bootable ESP, a board whose data partition is not called
# userdata, two eligible disks -- stands between this script and a write. carve.sh runs it AGAIN
# before it writes, deliberately, so nothing here is trusted downstream.
field() { printf '%s\n' "$1" | sed -n "s/^$2=//p"; }

select_target() {
  step "select-target"
  local sel
  sel="$("$SELECT" ${DISK:+"$DISK"})" \
    || die "no disk passed target selection -- nothing has been written"

  DISK="$(field "$sel" TARGET)"
  MODE="$(field "$sel" MODE)"
  SECTOR="$(field "$sel" SECTOR)"
  UD_INDEX="$(field "$sel" UD_INDEX)"
  UD_START="$(field "$sel" UD_START)"
  UD_END="$(field "$sel" UD_END)"
  CEIL="$(field "$sel" CEIL)"
  local v
  for v in DISK MODE SECTOR UD_INDEX UD_START UD_END CEIL; do
    [ -n "${!v}" ] || die "select-target.sh emitted no $v"
  done

  # The default intent, and the one combination where defaulting would be wrong. A disk that already
  # carries a retroforge install admits three different answers and this script may not pick one.
  if [ -z "$INTENT" ]; then
    [ "$MODE" = fresh ] \
      || die "$DISK already carries a retroforge install -- say --intent reinstall (keeps /home) or --intent fresh (erases it, and Android's data again)"
    INTENT=fresh
  fi
  [ "$INTENT" != reinstall ] || [ "$MODE" = reinstall ] \
    || die "--intent reinstall, but $DISK carries no retroforge install to reinstall over"
  [ "$INTENT" != fresh ] || [ -n "$UD_GIB" ] \
    || die "a fresh install needs --userdata-gib: how much of the disk Android keeps"

  # A REINSTALL THAT KEEPS /home HAS TO HAVE A /home TO KEEP, and nothing downstream checks it:
  # make_filesystems skips mkfs_home on that path and seed_home returns early, so an unformatted
  # partition yields an install that runs to the last byte, reports success, and leaves a device
  # that cannot mount /home. The failure is invisible until the user reboots into it.
  #
  # Reachable in the field and not only in the lab: an interrupted first install lays the GPT and
  # dies before mkfs_home, and the natural retry is exactly `--intent reinstall`. FOUND ON HARDWARE
  # 2026-08-21 -- the Pocket ACE after the Phase 4a gate is precisely this shape, eight partitions
  # present with only root-A and var-A carrying filesystems.
  #
  # It REFUSES rather than quietly upgrading to --erase-home. The user asked to keep something; a
  # spine that answered by erasing it would be wrong in the one direction that cannot be undone.
  # Checked here, where the disk is still untouched and the answer costs a message rather than a
  # reflash.
  if [ "$INTENT" = reinstall ] && [ "$ERASE_HOME" = 0 ]; then
    local hidx hdev htype
    hidx="$("$SGDISK" -p "$DISK" 2>/dev/null | awk '$NF == "retroforge-home" {print $1; exit}')" || true
    [ -n "${hidx:-}" ] \
      || die "$DISK carries no retroforge-home partition -- there is no /home to keep, so this is not a reinstall. Use --intent fresh."
    hdev="$(part_dev "$DISK" "$hidx")" \
      || die "cannot resolve p$hidx (retroforge-home) by partuuid -- refusing to guess a device name"
    htype="$(blkid -o value -s TYPE "$hdev" 2>/dev/null || true)"
    [ -n "$htype" ] \
      || die "$hdev (retroforge-home) holds no filesystem -- --intent reinstall promises to KEEP /home and there is nothing there to keep. Pass --erase-home to create it, or --intent fresh."
    log "/home on $hdev is $htype and will be kept"
  fi

  # Best-effort, for the record only. Nothing branches on it -- a wwid this could not read is a
  # forensic gap, not a reason to refuse an install.
  local base; base="${DISK#/dev/}"
  WWID="$(cat "/sys/block/$base/device/wwid" 2>/dev/null || true)"
  WWID="${WWID:-<unreadable>}"

  log "target $DISK (mode=$MODE, intent=$INTENT), userdata p$UD_INDEX ${UD_START}..${UD_END}, ${SECTOR}-byte sectors"
}

# =================================================================================================
# 3. the install record
# =================================================================================================
# A RECORD, NOT A BACKUP, and never a refusal condition. Decided 2026-08-05 (plan §3 rule 10) and
# written down here so it is not reintroduced by someone reading the §4c sketch's older
# "BACKUP GPTs" step:
#
#   - there is nowhere durable to put a backup. The only writable persistent medium is the
#     installer card, which means mutating the user's card to hold something nobody restores from;
#     $RUNDIR is tmpfs and evaporates at reboot.
#   - a restored GPT would point at a userdata we have already destroyed BY DESIGN, so it buys
#     nothing in the expected path. It helps only in a narrow bug window, and in the wrong-disk case
#     the user is in no state to run a restore anyway.
#   - an earlier draft refused to install if the backups could not be written. That was an outright
#     defect: a full or write-protected medium would block an install to protect a file nobody
#     reads. Hence best-effort throughout, and every failure here is a warn().
#
# What is kept is text: the pre-state dump, the target and its wwid, and the acknowledgement. It is
# forensics for a field failure and evidence of what the user agreed to.
RECORD=""
record() { [ -n "$RECORD" ] && printf '%s\n' "$*" >>"$RECORD" 2>/dev/null || true; }

open_install_record() {
  step "install record"
  # In the run dir: save-log.sh folds it into /var/log/retroforge/install.log when the unit stops.
  RECORD="$RUNDIR/record"
  : >"$RECORD" 2>/dev/null || { RECORD=""; warn "nowhere writable for the install record; continuing without one"; return 0; }

  record "=== retroforge-install $(date -u +%Y-%m-%dT%H:%M:%SZ) ==="
  record "target: $DISK  wwid: $WWID"
  record "mode: $MODE  intent: $INTENT  userdata: p$UD_INDEX $UD_START..$UD_END  ceiling: $CEIL"
  # sfdisk's dump is the pre-state in text: partition-for-partition, with uuids. Not a restore
  # source -- reading it back would recreate a table pointing at data that no longer exists.
  if command -v sfdisk >/dev/null 2>&1; then
    record "--- pre-state (sfdisk --dump) ---"
    sfdisk --dump "$DISK" >>"$RECORD" 2>/dev/null || warn "could not dump the pre-state"
  else
    record "--- pre-state: sfdisk is not on this image ---"
  fi
  log "recording to $RECORD"
}

# =================================================================================================
# 4. verify sources — BEFORE THE FIRST sgdisk
# =================================================================================================
# Plan §3 rule 11. The bundle can fail for ordinary reasons -- a half-published bundle, an expired
# certificate, a captive portal answering 200 with HTML -- and every one of them is free to discover
# here and costs the user their Android data to discover later.
#
# THE BUNDLE IS VERIFIED THROUGH rauc-session.sh --info, not through a `rauc info` spelled here. The
# synthesized config IS the mechanism of the install (bundle-formats, the keyring path,
# check-purpose), so a verify under a config of its own would be checking something other than what
# the install will do, and would be a second copy of that config waiting to drift.
# The running root: no signature (see the header), so what is checked is that this is the root, and
# that it fits. Both BEFORE the carve, for the same reason the bundle is verified here.
SOURCE_BYTES=""
mounted_root_source() {  # the device $RUNNING_MNT is mounted from, per the mount table; the last wins
  awk -v m="$RUNNING_MNT" '{ for (i = 1; i <= NF; i++) if ($i == "-") break; if ($5 == m) s = $(i + 2) }
                           END { print s }' "$MOUNTINFO"
}

size_bytes() {  # 2G / 256M / 512K -> bytes
  local n="${1%[KMGTkmgt]}" u="${1: -1}"
  case "$n" in ''|*[!0-9]*) return 1 ;; esac
  case "$u" in
    K|k) echo $(( n << 10 )) ;; M|m) echo $(( n << 20 )) ;;
    G|g) echo $(( n << 30 )) ;; T|t) echo $(( n << 40 )) ;;
    *) return 1 ;;
  esac
}

verify_running_root() {
  local src mounted type slot
  # shellcheck disable=SC2086  # DEVTEST is a predicate, not a path
  [ $DEVTEST "$SOURCE_ROOT" ] || die "$SOURCE_ROOT is not a block device"
  mounted="$(mounted_root_source)"
  [ -n "$mounted" ] || die "cannot tell what $RUNNING_MNT is mounted from"
  src="$(readlink -f "$SOURCE_ROOT")"
  [ "$src" = "$(readlink -f "$mounted")" ] \
    || die "$SOURCE_ROOT is not the running root ($RUNNING_MNT is mounted from $mounted) -- refusing to copy it"
  case "$src" in
    "$(readlink -f "$DISK")"*) die "$SOURCE_ROOT is on the target disk $DISK -- refusing to copy a disk onto itself" ;;
  esac
  type="$(blkid -o value -s TYPE "$src" 2>/dev/null || true)"
  [ "$type" = btrfs ] || die "$src holds ${type:-no filesystem}, not a btrfs root -- refusing to copy it"

  # The FILESYSTEM's size, not the partition's: a card's slot may be larger than the image in it
  # (4G slots from before 2026-10-03) and only the image has to fit root-a.
  SOURCE_BYTES="$(btrfs inspect-internal dump-super "$src" 2>/dev/null \
                  | awk '$1 == "dev_item.total_bytes" { print $2; exit }')"
  case "$SOURCE_BYTES" in ''|*[!0-9]*|0) die "cannot read the size of the btrfs on $src" ;; esac
  slot="$(awk '$1 == "rootfs-a" { print $2; exit }' "$PARTTABLE")"
  slot="$(size_bytes "$slot")" || die "partition-table.txt gives rootfs-a no usable size"
  [ "$SOURCE_BYTES" -le "$slot" ] \
    || die "the running root is $SOURCE_BYTES bytes and root-a is $slot -- it does not fit"
  log "running root $src: btrfs, $SOURCE_BYTES bytes, fits root-a ($slot)"
  record "source: running root $src ($SOURCE_BYTES bytes)"
}

verify_sources() {
  step "verify sources"

  if [ -n "$SOURCE_ROOT" ]; then
    verify_running_root
    return 0
  fi
  "$SESSION" --info "$BUNDLE" || die "the bundle did not verify -- refusing to touch the disk"
  log "bundle verified against $KEYRING"
  record "bundle: $BUNDLE (verified)"
}

# =================================================================================================
# 5. CONFIRM — the last point at which the disk is untouched
# =================================================================================================
# §4d. This function decides WHETHER consent was given; it does not draw anything. The screen is
# $CONFIRM, a separate program, so that the policy lives where the offline suite can drive it and
# the rendering lives where the display and the gamepad are.
#
# THE CONTRACT:
#     $CONFIRM --facts <file> --sequence <NESW>
#   displays the facts and the four face buttons in the order given, reads four presses, prints the
#   pressed sequence on stdout and exits 0. A non-zero exit means the user aborted.
#
# THE BUTTONS ARE NAMED BY POSITION, NOT BY THEIR PRINTED LETTER -- N/E/S/W, one character each.
# The letters silkscreened on the face cluster are NOT the same across the boards this installer is
# unified over: `A` is the EAST button on the AYANEO Pocket ACE and the SOUTH button on the Pocket
# S2. A screen that says "press A" therefore names a different physical button per device, and it
# does it on the one screen in this project where a misread is an erased Android. Position is the
# thing the hardware actually agrees on -- it is also what the wire carries, since InputPlumber
# presents a virtual Xbox pad and the kernel's own names (BTN_NORTH/EAST/SOUTH/WEST) are positional.
# So the alphabet is cardinal from the spine outwards, and both renderers draw the position.
#
# WHAT THE RANDOM SEQUENCE IS FOR. A single press on a focused Continue is one thumb-twitch from an
# erased Android, and a 3-second hold can be performed while looking away -- and a user who has done
# it once does it faster the second time. A sequence that is regenerated every attempt cannot be
# performed without reading the screen at that moment, which is the property the alternatives lack.
# It is the gamepad analogue of typing ERASE, and there is no text entry on this device to borrow.
#
# A WRONG PRESS RE-RANDOMISES AND REDRAWS rather than locking out. This is a recovery tool and it
# should not punish a slip; re-randomising is also what stops a mistake being brute-forced by
# repetition. The attempt budget is small and finite because an unbounded loop on a device with a
# stuck button is not consent either.
#
# THERE IS NO VALUE OF ANY VARIABLE THAT MEANS "CONSENT GIVEN". $CONFIRM names who renders the
# screen -- a substitute still has to run and return a sequence it was told to display. No
# consent.txt, no --yes: consent must never become a file someone can drop. If an
# unattended path is ever wanted it is a separate, deliberately-named artifact, never a quiet bypass.
CONFIRM_TRIES=${CONFIRM_TRIES:-5}
# One character per button, because random_sequence concatenates them and the renderers hand back a
# string this compares. Cardinal points, for the reason written out above.
FACE_BUTTONS=${FACE_BUTTONS:-N E S W}

# Seeded through RANDOM so the suite can assert two runs differ AND that a given seed reproduces.
random_sequence() {
  local pool=($FACE_BUTTONS) out="" i n
  while [ ${#pool[@]} -gt 0 ]; do
    n=${#pool[@]}
    i=$(( RANDOM % n ))
    out="$out${pool[$i]}"
    pool=("${pool[@]:0:$i}" "${pool[@]:$((i+1))}")
  done
  printf '%s\n' "$out"
}

# The facts the screen is DERIVED from -- never a fixed string. Vague totals invite "sure, whatever";
# a concrete "your Android data partition, 96.4 GiB, will be deleted" does not. Emitted as key=value
# so the renderer owns the words and this owns the numbers, and so the suite can assert that two
# different disks produce two different screens without parsing prose.
write_confirm_facts() {  # <file>
  local f="$1" ud_gib=$(( (UD_END - UD_START + 1) / (1073741824 / SECTOR) ))
  {
    printf 'INTENT=%s\n' "$INTENT"
    printf 'DISK=%s\n' "$DISK"
    printf 'WWID=%s\n' "$WWID"
    printf 'SECTOR=%s\n' "$SECTOR"
    if [ "$INTENT" = fresh ]; then
      # The Android-wipe screen. UD_GIB is what the user chose to leave Android, so both numbers are
      # quoted: what is lost and what remains.
      printf 'SCREEN=android-wipe\n'
      printf 'UD_INDEX=%s\n' "$UD_INDEX"
      printf 'UD_GIB_NOW=%s\n' "$ud_gib"
      printf 'UD_GIB_AFTER=%s\n' "$UD_GIB"
      # THE REMAINING TWO FACTS COME FROM carve.sh --plan, NOT FROM ARITHMETIC HERE. An earlier
      # version computed the free space from select-target's CEIL, and that is the wrong input: CEIL
      # stops at whatever follows userdata, which on a disk we already own is our own ESP, so the
      # expression yields zero. MEASURED on the Pocket ACE 2026-08-21 -- the screen said "RetroForge
      # will use the remaining 0 GiB" and the carve then handed it 90853 MiB. carve.sh's
      # effective_ceiling is the rule that is right, and asking it is what stops a second copy of
      # that rule existing here to drift away from it again.
      #
      # Best-effort in the SAME sense home_gib_or_unknown is: a plan this could not obtain must not
      # become numbers this invented. A screen that says `unknown` is honest; a screen that says 0
      # is what shipped, and it was wrong.
      local plan
      plan="$("$CARVE" plan "$DISK" "$UD_GIB" 2>/dev/null)" || plan=""
      printf 'RETROFORGE_GIB=%s\n' "$(field "$plan" RETROFORGE_GIB | grep -E '^[0-9]+$' || echo unknown)"
      printf 'REPLACES_OURS=%s\n' "$(field "$plan" REPLACES_OURS | grep -E '^[01]$' || echo unknown)"
      # What the fresh path does to an EXISTING retroforge /home, which is the whole reason
      # REPLACES_OURS exists. carve.sh has always said "it is being replaced, /home included" -- but
      # it says it after consent has been taken, where nobody can act on it.
      printf 'HOME_ACTION=create\n'
      printf 'HOME_GIB=%s\n' "$(home_gib_or_unknown)"
    else
      # The reinstall screen, and it is a SEPARATE branch rather than a variation, because the
      # Android-wipe text is flatly false here: there is no userdata to destroy. The two must not
      # share a path that could render one on the other's disk.
      printf 'SCREEN=reinstall\n'
      printf 'HOME_ACTION=%s\n' "$([ "$ERASE_HOME" = 1 ] && echo erase || echo keep)"
      printf 'HOME_GIB=%s\n' "$(home_gib_or_unknown)"
    fi
  } >"$f" || die "cannot write the consent facts to $f"
}

# Cheap and best-effort: the number that stops someone is "erase 214 GiB of games and saves", and a
# figure this could not read must not become a figure this invented.
home_gib_or_unknown() {
  local idx dev out
  idx="$("$SGDISK" -p "$DISK" 2>/dev/null | awk '$NF == "retroforge-home" {print $1; exit}')" || true
  [ -n "${idx:-}" ] || { printf 'unknown\n'; return 0; }
  dev="$(part_dev "$DISK" "$idx" 2>/dev/null)" || { printf 'unknown\n'; return 0; }
  out="$(df -BG --output=used "$dev" 2>/dev/null | tail -1 | tr -dc '0-9')" || true
  printf '%s\n' "${out:-unknown}"
}

# Fails closed: pgrep exits 1 for "none" and anything else means it could not answer. The wait is for
# the tail of the session the unit ended; nothing starts a new one, /run/nologin sees to that.
assert_no_session_user() {
  local i rc pids
  for (( i=0; ; i++ )); do
    # -U, the real uid: a setuid program run by the user keeps it, and -u would miss that.
    rc=0; pids="$("$PGREP" -U "$SESSION_UID")" || rc=$?
    [ "$rc" = 1 ] && return 0
    [ "$rc" = 0 ] || die "cannot tell whether the session user is gone (pgrep exited $rc) -- nothing has been written"
    [ "$i" -lt "$SESSION_WAIT" ] || break
    sleep 1
  done
  record "consent: refused, session user processes alive: ${pids//$'\n'/ }"
  die "a process of the session user is still running (${pids//$'\n'/ }), and it could answer the consent screen -- nothing has been written"
}

take_consent() {
  step "CONFIRM"
  assert_no_session_user
  local facts="$RUNDIR/confirm-facts" seq got attempt=1
  write_confirm_facts "$facts"

  while [ "$attempt" -le "$CONFIRM_TRIES" ]; do
    seq="$(random_sequence)"
    # `|| true` on the capture, then an explicit test: a non-zero exit from the renderer is an
    # ABORT, which is a legitimate answer and must not read as a crash.
    got="$("$CONFIRM" --facts "$facts" --sequence "$seq")" || {
      record "consent: aborted by the user at attempt $attempt"
      die "the install was cancelled -- nothing has been written"
    }
    got="${got//[[:space:]]/}"
    if [ "$got" = "$seq" ]; then
      record "consent: given at $(date -u +%Y-%m-%dT%H:%M:%SZ), sequence $seq, attempt $attempt"
      record "--- what was shown ---"
      [ -n "$RECORD" ] && cat "$facts" >>"$RECORD" 2>/dev/null || true
      log "consent given"
      return 0
    fi
    warn "that was not the sequence shown; try again ($attempt/$CONFIRM_TRIES)"
    attempt=$(( attempt + 1 ))
  done
  record "consent: NOT given after $CONFIRM_TRIES attempts"
  die "consent was not given after $CONFIRM_TRIES attempts -- nothing has been written"
}

# =================================================================================================
# 6. the carve — the first write
# =================================================================================================
# Delegated to carve.sh, which re-runs select-target.sh itself and has its own 63-case suite plus a
# hardware gate (Pocket ACE, 2026-08-21: fresh -> uninstall -> fresh, p1..p10 byte-identical after
# the whole cycle). Nothing about the geometry is passed in beyond the user's chosen Android share:
# the carve acts on the disk as it is at that moment, not on what this script read a minute ago.
carve() {
  step "carve"
  local map
  if [ "$INTENT" = fresh ]; then
    map="$("$CARVE" fresh "$DISK" "$UD_GIB")" || die "the carve failed -- see above"
  else
    map="$("$CARVE" reinstall "$DISK")" || die "$DISK is not a complete retroforge install"
  fi

  local name idx
  while IFS='=' read -r name idx; do
    [ -n "$name" ] || continue
    PART["$name"]="$idx"
  done <<<"$map"

  for name in RETROFORGE-ESP retroforge-efi-A retroforge-efi-B retroforge-root-A retroforge-root-B \
              retroforge-var-A retroforge-var-B retroforge-home; do
    [ -n "${PART[$name]:-}" ] || die "the carve did not report an index for $name"
  done
  record "layout: $(for name in "${!PART[@]}"; do printf '%s=%s ' "$name" "${PART[$name]}"; done)"

  # A SETTLE IS NOT A BARRIER. part_dev builds the by-partuuid path from the GPT, but it is udev
  # that has to publish the symlink, and it does that asynchronously. carve.sh settles after the
  # append, and that is still not enough on a RE-carve: the table is rewritten twice in quick
  # succession (delete_ours, then the append), so the old nodes are being removed while the new
  # ones are appearing, and `udevadm settle` can return before the kernel has queued the uevents it
  # would have waited for.
  #
  # MEASURED on the Pocket ACE, 2026-08-22, second install onto a disk that already carried ours:
  # seven of the eight symlinks were present and retroforge-efi-B was not, so the run died on
  # "not a block device" -- on a disk whose userdata had already been shrunk and zeroed. The wait
  # is bounded (10s) and costs nothing when the node is already there, which is every other run.
  wait_for_dev() {  # <path> -> 0 once it exists, non-zero after ~10s
    local dev="$1" i
    for i in $(seq 1 50); do
      # shellcheck disable=SC2086  # DEVTEST is a predicate, not a path
      [ $DEVTEST "$dev" ] && return 0
      if [ "$i" = 1 ] && command -v udevadm >/dev/null 2>&1; then
        udevadm settle >/dev/null 2>&1 || true
        continue                                   # re-test immediately after the settle
      fi
      sleep 0.2
    done
    return 1
  }

  # THE INDEX -> DEVICE STEP, and the one rule every write below depends on. Resolved by PARTUUID
  # through lib-slotwrite.sh's part_dev; nothing here concatenates a disk and an index, because the
  # `p` infix (mmcblk0p11 against sda11) is exactly what this fleet cannot test -- every board is
  # UFS. A naming bug of that shape would first appear on a customer's eMMC device, mid-install, on
  # a disk whose userdata is already gone.
  for name in "${!PART[@]}"; do
    DEV["$name"]="$(part_dev "$DISK" "${PART[$name]}")" \
      || die "cannot resolve p${PART[$name]} ($name) by partuuid -- refusing to guess a device name"
    wait_for_dev "${DEV[$name]}" \
      || die "${DEV[$name]} ($name) is not a block device"
  done
  log "eight partitions resolved by partuuid"
}

# =================================================================================================
# 7. filesystems
# =================================================================================================
# FOUR, not six. var-a is NOT here: seed_var() reformats it itself, because the reformat and the
# population are one operation -- a var partition that has been mkfs'd and not populated is a slot
# that does not boot. And var-b is not touched AT ALL, matching the release card's empty-B shape;
# the first OTA fills it. root-a is RAUC's.
#
# /home is skipped on a reinstall that keeps it. That is the whole content of the reinstall promise
# and it is the only line here that implements it.
make_filesystems() {
  step "filesystems"
  mkfs_esp "${DEV[RETROFORGE-ESP]}";           log "esp    ${DEV[RETROFORGE-ESP]}"
  mkfs_efi "${DEV[retroforge-efi-A]}" A;       log "efi-a  ${DEV[retroforge-efi-A]}"
  mkfs_efi "${DEV[retroforge-efi-B]}" B;       log "efi-b  ${DEV[retroforge-efi-B]}"
  if [ "$INTENT" = fresh ] || [ "$ERASE_HOME" = 1 ]; then
    mkfs_home "${DEV[retroforge-home]}";       log "home   ${DEV[retroforge-home]} (recreated)"
  else
    log "home   ${DEV[retroforge-home]} (kept -- games and saves untouched)"
  fi
}

# =================================================================================================
# 8. the root slot
# =================================================================================================
# rauc-session.sh owns this entirely: the synthesized config, the private bus, the proof that the
# service holding de.pengutronix.rauc is the one we started, and the ~4 GB stream. RETROFORGE_TARGET_VAR_A
# is how the spine tells the handler where /var goes -- the handler cannot derive it, because the
# config declares exactly one slot and it is the root.
install_root() {
  step "root slot"
  if [ -n "$SOURCE_ROOT" ]; then
    copy_running_root
    return 0
  fi
  RETROFORGE_TARGET_VAR_A="${DEV[retroforge-var-A]}" \
    "$SESSION" "${DEV[retroforge-root-A]}" "$BUNDLE" \
    || die "the root slot was not installed"
  record "root-a: installed from $BUNDLE"
}

# The running-root source. The copy is the filesystem's bytes and no more, then the handler a bundle
# install runs, given what rauc would have given it: one target slot and its device. It re-randomises
# the fsid BEFORE anything mounts the copy -- until then it carries the running root's fsid, and the
# kernel refuses a second device with a mounted filesystem's fsid and devid rather than switching to
# it, so a udev scan of the fresh partition cannot steal the running root.
copy_running_root() {
  local dst="${DEV[retroforge-root-A]}" have=""
  have="$(blockdev --getsize64 "$dst" 2>/dev/null || true)"
  if [ -n "$have" ] && [ "$have" -lt "$SOURCE_BYTES" ]; then
    die "root-a ($dst) is $have bytes, smaller than the running root's $SOURCE_BYTES"
  fi
  log "copying the running root $SOURCE_ROOT ($SOURCE_BYTES bytes) into $dst"
  dd if="$SOURCE_ROOT" of="$dst" bs=4M count="$SOURCE_BYTES" iflag=count_bytes conv=fsync status=none \
    || die "copying the running root into $dst failed"
  RAUC_TARGET_SLOTS=1 RAUC_SLOT_DEVICE_1="$dst" \
  RETROFORGE_TARGET_VAR_A="${DEV[retroforge-var-A]}" \
    "$POST_INSTALL" \
    || die "the copied root slot could not be finished"
  record "root-a: copied from the running root $SOURCE_ROOT"
}

# The Wi-Fi networks set up on the card, so the installed device joins them at its first boot instead
# of starting offline. They go where NetworkManager writes a network joined from Settings: the /etc
# overlay upper in var-a, which seed_var has just created. NetworkManager itself is still running
# here (the installer starts from Settings, over Wi-Fi), so its directory is complete.
#
# Wi-Fi profiles only: a profile of another type -- the dev card's USB gadget, a wired one -- describes
# the card's setup, not the network the user is on. Regular files only, 0600 as NetworkManager
# insists, or it ignores the file.
#
# BEST-EFFORT, like the install record. This runs after the carve, and a network that did not come
# across costs the user a password typed again; refusing here would cost them an install whose
# Android data is already gone.
carry_wifi() {
  local src="$NM_CONNECTIONS" mnt="$RUNDIR/var-a" dst f n=0
  if [ ! -d "$src" ]; then
    log "no Wi-Fi networks to carry over ($src does not exist)"
    record "wifi: none ($src missing)"
    return 0
  fi
  mount_at "${DEV[retroforge-var-A]}" "$mnt"
  dst="$mnt/lib/overlays/etc/upper/NetworkManager/system-connections"
  if mkdir -p "$dst" && chmod 0700 "$dst"; then
    for f in "$src"/*.nmconnection; do
      [ -f "$f" ] && [ ! -L "$f" ] || continue
      grep -qxE '[[:space:]]*type[[:space:]]*=[[:space:]]*(wifi|802-11-wireless)[[:space:]]*' "$f" || continue
      if cp "$f" "$dst/" && chmod 0600 "$dst/${f##*/}"; then
        n=$(( n + 1 ))
        log "wifi: carried over ${f##*/}"
      else
        warn "could not carry over the Wi-Fi network ${f##*/}"
      fi
    done
  else
    warn "cannot create $dst -- the Wi-Fi networks were not carried over"
  fi
  sync
  unmount_at "$mnt"
  log "carried over $n Wi-Fi network(s)"
  record "wifi: $n network(s) carried over"
}

# =================================================================================================
# 9. /home
# =================================================================================================
# The layout is image/lib-homestage.sh, shared verbatim with make-sdcard.sh, so an installed device
# and a flashed card present the same home: an empty `player` directory owned by uid 1000.
seed_home() {
  if [ "$INTENT" = reinstall ] && [ "$ERASE_HOME" = 0 ]; then
    step "/home (kept)"
    log "left untouched, as the reinstall promised"
    record "home: kept"
    return 0
  fi
  step "/home"
  local mnt="$RUNDIR/home"
  mount_at "${DEV[retroforge-home]}" "$mnt"
  stage_player_home "$mnt"
  sync
  unmount_at "$mnt"
  record "home: player home staged"
  log "player home staged"
}

# =================================================================================================
# 10. the efi partitions
# =================================================================================================
# Both of them, both fully populated, and B populated even though nothing will boot it yet: B stays
# out of the ESP GRUB's way because the grubenv says B_OK=0 (arm_esp), and its stage 2 being ready
# means the first OTA has nothing to lay down but a root and a var.
#
# THE FILES COME OUT OF THE ROOT WE JUST WROTE, never off the card. grubaa64.efi and
# grub-<slot>.cfg are boot software owned by the same build that ships /boot/vmlinuz.efi and
# /lib/modules/<ver> inside that rootfs, so taking them from there makes the pairing true by
# construction: there is no way to install a root whose stage 2 does not boot it.
ROOTMNT=""
mount_new_root() {
  ROOTMNT="$RUNDIR/root-a"
  mount_at "${DEV[retroforge-root-A]}" "$ROOTMNT" -o ro
  [ -d "$ROOTMNT/usr/lib/retroforge/boot" ] \
    || die "the freshly written root carries no /usr/lib/retroforge/boot -- it is not a retroforge rootfs"
}

write_efi_partitions() {
  step "efi-a / efi-b"
  local bootdir="$ROOTMNT/usr/lib/retroforge/boot"

  # parts.env: WHERE OUR EIGHT ACTUALLY ARE on this disk. On a card they are 1..8; here they are
  # whatever genpart.sh --append found room for, which is neither row order nor contiguous. Stage 2
  # cannot address anything without this, and it is the one artifact whose contents are per-disk.
  local envkv=()
  local kv
  while read -r kv; do envkv+=("$kv"); done < <(
    for name in RETROFORGE-ESP retroforge-efi-A retroforge-efi-B retroforge-root-A \
                retroforge-root-B retroforge-var-A retroforge-var-B retroforge-home; do
      printf '%s=%s\n' "$name" "${PART[$name]}"
    done | parts_env_from_genpart_map
  )

  local slot mnt
  for slot in A B; do
    mnt="$RUNDIR/efi-${slot,,}"
    mount_at "${DEV[retroforge-efi-$slot]}" "$mnt"
    write_efi_partition "$mnt" "$slot" "$bootdir"
    write_parts_env "$mnt" "${envkv[@]}"
    sync
    log "efi-${slot,,}: stage 2, parts.env"
  done
  record "efi: parts.env ${envkv[*]}"
  # efi-a stays mounted: arm_esp copies its parts.env onto the ESP.
  unmount_at "$RUNDIR/efi-b"
}

# =================================================================================================
# 11. the shared ESP, and the last byte
# =================================================================================================
# Ordered inside the step as carefully as the steps are ordered against each other:
#   grubenv       the pristine env block from the root, with RAUC's slot state set in it by the
#                 root's own grub-editenv: A first and OK, B not OK. RAUC makes B OK itself the
#                 first time it writes it.
#   extras        parts.env (from efi-a, still mounted) and OpenABL's \dtbs\qcom
#   stage 1       refresh_esp_stage1, whose own last write is bootaa64.efi -- the byte that flips
#                 ABL from the card to this disk.
EDITENV=${EDITENV:-}
# saved_entry only: rf_board_ok means "this disk has confirmed a boot on it", and it has not yet.
# Best-effort, and shaped like a board id or left out: without it the first boot shows the board menu.
carry_board() {  # <editenv> <grubenv>
  local board
  [ -r "$CARD_GRUBENV" ] || { log "no card grubenv at $CARD_GRUBENV; the first boot will ask for the board"; return 0; }
  board="$("$1" "$CARD_GRUBENV" list 2>/dev/null | sed -n 's/^saved_entry=//p')" || board=""
  case "$board" in
    ''|*[!a-z0-9-]*) log "no usable saved board on the card; the first boot will ask for the board"; return 0 ;;
  esac
  "$1" "$2" set "saved_entry=$board" || { warn "could not carry the board over"; return 0; }
  log "board: $board, as saved on the card"
  record "boot: board $board carried over from the card"
}

arm_esp() {
  step "ESP"
  local esp="$RUNDIR/esp" bootdir="$ROOTMNT/usr/lib/retroforge/boot"
  mount_at "${DEV[RETROFORGE-ESP]}" "$esp"

  mkdir -p "$esp/EFI/steamos" || die "cannot create the ESP directories"
  [ -f "$bootdir/grubenv" ] \
    || die "the installed root carries no pristine grubenv at /usr/lib/retroforge/boot/grubenv"
  cp -f "$bootdir/grubenv" "$esp/EFI/steamos/grubenv" || die "cannot install the grubenv"

  # grub-editenv comes out of the ROOT WE JUST WROTE by preference, so the tool and the block are
  # the pair that shipped together; the running image's own copy is the fallback.
  local editenv="${EDITENV:-$ROOTMNT/usr/bin/grub-editenv}"
  [ -x "$editenv" ] || editenv="$(command -v grub-editenv 2>/dev/null || true)"
  [ -n "$editenv" ] && [ -x "$editenv" ] || die "no grub-editenv to arm the slot state with"
  "$editenv" "$esp/EFI/steamos/grubenv" set "ORDER=A B" "A_OK=1" "A_TRY=0" "B_OK=0" "B_TRY=0" \
    || die "grub-editenv could not arm the slot state"
  carry_board "$editenv" "$esp/EFI/steamos/grubenv"
  sync
  log "slot state armed: A first, B not OK"
  record "boot: grubenv ORDER=A B, A_OK=1, B_OK=0"

  refresh_esp_extras "$esp" "$RUNDIR/efi-a" "$bootdir"

  # THE LAST WRITE OF THE INSTALL.
  refresh_esp_stage1 "$esp" "$bootdir"
  unmount_at "$esp"
  unmount_at "$RUNDIR/efi-a"
  unmount_at "$ROOTMNT"
  record "esp: ESP GRUB written; the device now boots internally"
  log "ESP GRUB written -- this disk is now what ABL starts"
}

# =================================================================================================
main() {
  recon
  select_target
  open_install_record
  verify_sources
  take_consent
  carve
  make_filesystems
  install_root
  carry_wifi
  seed_home
  mount_new_root
  write_efi_partitions
  arm_esp
  sync

  step "done"
  cat <<EOF
RetroForge is installed on $DISK.

  Android still boots and arrives factory-reset; its apps, saves and photos are gone.
  RetroForge on your SD card was not touched.
  The device now boots RetroForge from internal storage by default.
  To boot Android, or to boot this installer again, hold Volume Up at startup and pick it
  from the bootloader's own menu -- "force external" is what reaches the card once an
  internal install exists.
EOF
}

main
